; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; (X +nsw A) +nsw (V -nsw A) is reassociated to X + V. The original sum is
; exactly X + V without signed overflow, so the result keeps nsw.

define i32 @add_sub_nsw(i32 %x, i32 %a, i32 %v) {
; CHECK-LABEL: define i32 @add_sub_nsw(
; CHECK-SAME: i32 [[X:%.*]], i32 [[A:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = add nsw i32 [[X]], [[V]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %s = add nsw i32 %x, %a
  %c = sub nsw i32 %v, %a
  %r = add nsw i32 %s, %c
  ret i32 %r
}

; The sub as the first operand of the outer add.
define i32 @add_sub_nsw_commuted(i32 %x, i32 %a, i32 %v) {
; CHECK-LABEL: define i32 @add_sub_nsw_commuted(
; CHECK-SAME: i32 [[X:%.*]], i32 [[A:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = add nsw i32 [[X]], [[V]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %s = add nsw i32 %x, %a
  %c = sub nsw i32 %v, %a
  %r = add nsw i32 %c, %s
  ret i32 %r
}

; The simplification lets a comparison of the two sums fold, as for the
; bounds of a block of rows: start = X + (k + 1), end = start + (M - (k + 1)).
define i1 @range_not_empty(i32 %x, i32 %k, i32 %m) {
; CHECK-LABEL: define i1 @range_not_empty(
; CHECK-SAME: i32 [[X:%.*]], i32 [[K:%.*]], i32 [[M:%.*]]) {
; CHECK-NEXT:    [[K1:%.*]] = add nsw i32 [[K]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[K1]], [[M]]
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %k1 = add nsw i32 %k, 1
  %start = add nsw i32 %x, %k1
  %len = sub nsw i32 %m, %k1
  %end = add nsw i32 %start, %len
  %cmp = icmp slt i32 %start, %end
  ret i1 %cmp
}

