; (gep inbounds p, x+y) with x and y both non-constant is not split into
; (gep (gep p, x), y) when that would drop inbounds: the flag proves that the
; final address does not wrap, which LoopTermFold relies on.

define ptr @keep_inbounds(ptr %p, i64 %x, i64 %y) {
; KEEP-LABEL: define ptr @keep_inbounds(
; KEEP-SAME: ptr [[P:%.*]], i64 [[X:%.*]], i64 [[Y:%.*]]) {
; KEEP-NEXT:    [[IDX:%.*]] = add nsw i64 [[X]], [[Y]]
; KEEP-NEXT:    [[G:%.*]] = getelementptr inbounds [4 x i8], ptr [[P]], i64 [[IDX]]
; KEEP-NEXT:    ret ptr [[G]]
;
; SPLIT-LABEL: define ptr @keep_inbounds(
; SPLIT-SAME: ptr [[P:%.*]], i64 [[X:%.*]], i64 [[Y:%.*]]) {
; SPLIT-NEXT:    [[TMP1:%.*]] = getelementptr [4 x i8], ptr [[P]], i64 [[X]]
; SPLIT-NEXT:    [[G:%.*]] = getelementptr [4 x i8], ptr [[TMP1]], i64 [[Y]]
; SPLIT-NEXT:    ret ptr [[G]]
;
  %idx = add nsw i64 %x, %y
  %g = getelementptr inbounds float, ptr %p, i64 %idx
  ret ptr %g
}

