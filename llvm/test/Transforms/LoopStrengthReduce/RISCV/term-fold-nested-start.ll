; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes='loop(loop-term-fold-prepare,loop-reduce,loop-term-fold)' < %s | FileCheck %s

; When LoopTermFold replaces the exit test of an inner loop with a pointer
; compare, the start of that pointer usually depends on the parent loop (a
; row pointer). The terminating value must then be the start value plus a
; distance that does not change in the parent loop, not a fresh expansion of
; base + row * stride, which needs a multiply in every parent iteration.

target datalayout = "e-m:e-p:32:32-i64:64-n32-S128"
target triple = "riscv32-unknown-unknown"

; mat[m][k] *= f for k in [0, n), row by row.
define void @scale_rows(ptr %mat, i32 %rows, i32 %n, float %f) {
;
; CHECK-LABEL: define void @scale_rows(
; CHECK-SAME: ptr [[MAT:%.*]], i32 [[ROWS:%.*]], i32 [[N:%.*]], float [[F:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[N_POS:%.*]] = icmp sgt i32 [[N]], 0
; CHECK-NEXT:    [[ROWS_POS:%.*]] = icmp sgt i32 [[ROWS]], 0
; CHECK-NEXT:    [[GO:%.*]] = and i1 [[N_POS]], [[ROWS_POS]]
; CHECK-NEXT:    br i1 [[GO]], label %[[OUTER_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shl i32 [[N]], 2
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[LSR_IV1:%.*]] = phi ptr [ [[MAT]], %[[OUTER_PREHEADER]] ], [ [[SCEVGEP:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[M:%.*]] = phi i32 [ [[M_NEXT:%.*]], %[[OUTER_LATCH]] ], [ 0, %[[OUTER_PREHEADER]] ]
; CHECK-NEXT:    [[LSR_FOLD_TERM_COND_END:%.*]] = getelementptr i8, ptr [[LSR_IV1]], i32 [[TMP0]]
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[LSR_IV2:%.*]] = phi ptr [ [[SCEVGEP3:%.*]], %[[INNER]] ], [ [[LSR_IV1]], %[[OUTER]] ]
; CHECK-NEXT:    [[V:%.*]] = load float, ptr [[LSR_IV2]], align 4
; CHECK-NEXT:    [[S:%.*]] = fmul float [[V]], [[F]]
; CHECK-NEXT:    store float [[S]], ptr [[LSR_IV2]], align 4
; CHECK-NEXT:    [[SCEVGEP3]] = getelementptr i8, ptr [[LSR_IV2]], i32 4
; CHECK-NEXT:    [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND:%.*]] = icmp eq ptr [[SCEVGEP3]], [[LSR_FOLD_TERM_COND_END]]
; CHECK-NEXT:    br i1 [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND]], label %[[OUTER_LATCH]], label %[[INNER]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[M_NEXT]] = add nuw nsw i32 [[M]], 1
; CHECK-NEXT:    [[SCEVGEP]] = getelementptr i8, ptr [[LSR_IV1]], i32 [[TMP0]]
; CHECK-NEXT:    [[OUTER_DONE:%.*]] = icmp eq i32 [[M_NEXT]], [[ROWS]]
; CHECK-NEXT:    br i1 [[OUTER_DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %n.pos = icmp sgt i32 %n, 0
  %rows.pos = icmp sgt i32 %rows, 0
  %go = and i1 %n.pos, %rows.pos
  br i1 %go, label %outer, label %exit

outer:
  %m = phi i32 [ 0, %entry ], [ %m.next, %outer.latch ]
  %row.off = mul nsw i32 %m, %n
  %row = getelementptr inbounds float, ptr %mat, i32 %row.off
  br label %inner

inner:
  %k = phi i32 [ 0, %outer ], [ %k.next, %inner ]
  %p = getelementptr inbounds float, ptr %row, i32 %k
  %v = load float, ptr %p, align 4
  %s = fmul float %v, %f
  store float %s, ptr %p, align 4
  %k.next = add nuw nsw i32 %k, 1
  %inner.done = icmp eq i32 %k.next, %n
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %m.next = add nuw nsw i32 %m, 1
  %outer.done = icmp eq i32 %m.next, %rows
  br i1 %outer.done, label %exit, label %outer

exit:
  ret void
}

; Triangular update as in an LU decomposition: the inner trip count depends
; on the grandparent loop (k) but not on the parent loop (m), so the distance
; is still computed outside the parent loop.
define void @lu_rows(ptr %mat, i32 %dim, float %f) {
;
; CHECK-LABEL: define void @lu_rows(
; CHECK-SAME: ptr [[MAT:%.*]], i32 [[DIM:%.*]], float [[F:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DIM_POS:%.*]] = icmp sgt i32 [[DIM]], 1
; CHECK-NEXT:    br i1 [[DIM_POS]], label %[[KLOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[KLOOP_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shl i32 [[DIM]], 2
; CHECK-NEXT:    [[TMP1:%.*]] = add i32 [[TMP0]], 4
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[MAT]], i32 [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = add i32 [[TMP0]], -4
; CHECK-NEXT:    br label %[[KLOOP:.*]]
; CHECK:       [[KLOOP]]:
; CHECK-NEXT:    [[LSR_IV3:%.*]] = phi ptr [ [[SCEVGEP]], %[[KLOOP_PREHEADER]] ], [ [[SCEVGEP4:%.*]], %[[KLOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[KK:%.*]] = phi i32 [ [[KK_NEXT:%.*]], %[[KLOOP_LATCH]] ], [ 0, %[[KLOOP_PREHEADER]] ]
; CHECK-NEXT:    [[TMP3:%.*]] = mul i32 [[KK]], -4
; CHECK-NEXT:    [[TMP4:%.*]] = add i32 [[TMP2]], [[TMP3]]
; CHECK-NEXT:    [[FIRST:%.*]] = add nuw nsw i32 [[KK]], 1
; CHECK-NEXT:    [[HAS_ROWS:%.*]] = icmp slt i32 [[FIRST]], [[DIM]]
; CHECK-NEXT:    br i1 [[HAS_ROWS]], label %[[MLOOP_PREHEADER:.*]], label %[[KLOOP_LATCH]]
; CHECK:       [[MLOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[MLOOP:.*]]
; CHECK:       [[MLOOP]]:
; CHECK-NEXT:    [[LSR_IV5:%.*]] = phi ptr [ [[LSR_IV3]], %[[MLOOP_PREHEADER]] ], [ [[SCEVGEP6:%.*]], %[[MLOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[M:%.*]] = phi i32 [ [[M_NEXT:%.*]], %[[MLOOP_LATCH]] ], [ [[FIRST]], %[[MLOOP_PREHEADER]] ]
; CHECK-NEXT:    [[LSR_FOLD_TERM_COND_END:%.*]] = getelementptr i8, ptr [[LSR_IV5]], i32 [[TMP4]]
; CHECK-NEXT:    br label %[[NLOOP:.*]]
; CHECK:       [[NLOOP]]:
; CHECK-NEXT:    [[LSR_IV7:%.*]] = phi ptr [ [[SCEVGEP8:%.*]], %[[NLOOP]] ], [ [[LSR_IV5]], %[[MLOOP]] ]
; CHECK-NEXT:    [[A:%.*]] = load float, ptr [[LSR_IV7]], align 4
; CHECK-NEXT:    [[R:%.*]] = fmul float [[A]], [[F]]
; CHECK-NEXT:    store float [[R]], ptr [[LSR_IV7]], align 4
; CHECK-NEXT:    [[SCEVGEP8]] = getelementptr i8, ptr [[LSR_IV7]], i32 4
; CHECK-NEXT:    [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND:%.*]] = icmp eq ptr [[SCEVGEP8]], [[LSR_FOLD_TERM_COND_END]]
; CHECK-NEXT:    br i1 [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND]], label %[[MLOOP_LATCH]], label %[[NLOOP]]
; CHECK:       [[MLOOP_LATCH]]:
; CHECK-NEXT:    [[M_NEXT]] = add nuw nsw i32 [[M]], 1
; CHECK-NEXT:    [[SCEVGEP6]] = getelementptr i8, ptr [[LSR_IV5]], i32 [[TMP0]]
; CHECK-NEXT:    [[M_DONE:%.*]] = icmp eq i32 [[M_NEXT]], [[DIM]]
; CHECK-NEXT:    br i1 [[M_DONE]], label %[[KLOOP_LATCH_LOOPEXIT:.*]], label %[[MLOOP]]
; CHECK:       [[KLOOP_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[KLOOP_LATCH]]
; CHECK:       [[KLOOP_LATCH]]:
; CHECK-NEXT:    [[KK_NEXT]] = add nuw nsw i32 [[KK]], 1
; CHECK-NEXT:    [[SCEVGEP4]] = getelementptr i8, ptr [[LSR_IV3]], i32 [[TMP1]]
; CHECK-NEXT:    [[K_DONE:%.*]] = icmp eq i32 [[KK_NEXT]], [[DIM]]
; CHECK-NEXT:    br i1 [[K_DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[KLOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %dim.pos = icmp sgt i32 %dim, 1
  br i1 %dim.pos, label %kloop, label %exit

kloop:
  %kk = phi i32 [ 0, %entry ], [ %kk.next, %kloop.latch ]
  %first = add nuw nsw i32 %kk, 1
  %has.rows = icmp slt i32 %first, %dim
  br i1 %has.rows, label %mloop, label %kloop.latch

mloop:
  %m = phi i32 [ %first, %kloop ], [ %m.next, %mloop.latch ]
  %row.off = mul nsw i32 %m, %dim
  %row = getelementptr inbounds float, ptr %mat, i32 %row.off
  br label %nloop

nloop:
  %n = phi i32 [ %first, %mloop ], [ %n.next, %nloop ]
  %pa = getelementptr inbounds float, ptr %row, i32 %n
  %a = load float, ptr %pa, align 4
  %r = fmul float %a, %f
  store float %r, ptr %pa, align 4
  %n.next = add nuw nsw i32 %n, 1
  %n.done = icmp eq i32 %n.next, %dim
  br i1 %n.done, label %mloop.latch, label %nloop

mloop.latch:
  %m.next = add nuw nsw i32 %m, 1
  %m.done = icmp eq i32 %m.next, %dim
  br i1 %m.done, label %kloop.latch, label %mloop

kloop.latch:
  %kk.next = add nuw nsw i32 %kk, 1
  %k.done = icmp eq i32 %kk.next, %dim
  br i1 %k.done, label %exit, label %kloop

exit:
  ret void
}

; With a pivot-row access, LoopTermFold picks the pivot-row pointer, whose end
; does not depend on the parent loop: the plain expansion is kept.
define void @lu_rows_pivot(ptr %mat, ptr %pivrow, i32 %dim, float %f) {
; CHECK-LABEL: define void @lu_rows_pivot(
; CHECK-SAME: ptr [[MAT:%.*]], ptr [[PIVROW:%.*]], i32 [[DIM:%.*]], float [[F:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DIM_POS:%.*]] = icmp sgt i32 [[DIM]], 1
; CHECK-NEXT:    br i1 [[DIM_POS]], label %[[KLOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[KLOOP_PREHEADER]]:
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[PIVROW]], i32 4
; CHECK-NEXT:    [[TMP0:%.*]] = shl i32 [[DIM]], 2
; CHECK-NEXT:    [[TMP1:%.*]] = add i32 [[TMP0]], 4
; CHECK-NEXT:    [[SCEVGEP7:%.*]] = getelementptr i8, ptr [[MAT]], i32 [[TMP1]]
; CHECK-NEXT:    [[SCEVGEP14:%.*]] = getelementptr i8, ptr [[PIVROW]], i32 [[TMP0]]
; CHECK-NEXT:    br label %[[KLOOP:.*]]
; CHECK:       [[KLOOP]]:
; CHECK-NEXT:    [[LSR_IV8:%.*]] = phi ptr [ [[SCEVGEP7]], %[[KLOOP_PREHEADER]] ], [ [[SCEVGEP9:%.*]], %[[KLOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[LSR_IV3:%.*]] = phi ptr [ [[SCEVGEP]], %[[KLOOP_PREHEADER]] ], [ [[SCEVGEP4:%.*]], %[[KLOOP_LATCH]] ]
; CHECK-NEXT:    [[KK:%.*]] = phi i32 [ [[KK_NEXT:%.*]], %[[KLOOP_LATCH]] ], [ 0, %[[KLOOP_PREHEADER]] ]
; CHECK-NEXT:    [[FIRST:%.*]] = add nuw nsw i32 [[KK]], 1
; CHECK-NEXT:    [[HAS_ROWS:%.*]] = icmp slt i32 [[FIRST]], [[DIM]]
; CHECK-NEXT:    br i1 [[HAS_ROWS]], label %[[MLOOP_PREHEADER:.*]], label %[[KLOOP_LATCH]]
; CHECK:       [[MLOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[MLOOP:.*]]
; CHECK:       [[MLOOP]]:
; CHECK-NEXT:    [[LSR_IV10:%.*]] = phi ptr [ [[LSR_IV8]], %[[MLOOP_PREHEADER]] ], [ [[SCEVGEP11:%.*]], %[[MLOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[M:%.*]] = phi i32 [ [[M_NEXT:%.*]], %[[MLOOP_LATCH]] ], [ [[FIRST]], %[[MLOOP_PREHEADER]] ]
; CHECK-NEXT:    br label %[[NLOOP:.*]]
; CHECK:       [[NLOOP]]:
; CHECK-NEXT:    [[LSR_IV12:%.*]] = phi ptr [ [[SCEVGEP13:%.*]], %[[NLOOP]] ], [ [[LSR_IV10]], %[[MLOOP]] ]
; CHECK-NEXT:    [[LSR_IV5:%.*]] = phi ptr [ [[SCEVGEP6:%.*]], %[[NLOOP]] ], [ [[LSR_IV3]], %[[MLOOP]] ]
; CHECK-NEXT:    [[A:%.*]] = load float, ptr [[LSR_IV12]], align 4
; CHECK-NEXT:    [[B:%.*]] = load float, ptr [[LSR_IV5]], align 4
; CHECK-NEXT:    [[PROD:%.*]] = fmul float [[B]], [[F]]
; CHECK-NEXT:    [[R:%.*]] = fsub float [[A]], [[PROD]]
; CHECK-NEXT:    store float [[R]], ptr [[LSR_IV12]], align 4
; CHECK-NEXT:    [[SCEVGEP6]] = getelementptr i8, ptr [[LSR_IV5]], i32 4
; CHECK-NEXT:    [[SCEVGEP13]] = getelementptr i8, ptr [[LSR_IV12]], i32 4
; CHECK-NEXT:    [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND:%.*]] = icmp eq ptr [[SCEVGEP6]], [[SCEVGEP14]]
; CHECK-NEXT:    br i1 [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND]], label %[[MLOOP_LATCH]], label %[[NLOOP]]
; CHECK:       [[MLOOP_LATCH]]:
; CHECK-NEXT:    [[M_NEXT]] = add nuw nsw i32 [[M]], 1
; CHECK-NEXT:    [[SCEVGEP11]] = getelementptr i8, ptr [[LSR_IV10]], i32 [[TMP0]]
; CHECK-NEXT:    [[M_DONE:%.*]] = icmp eq i32 [[M_NEXT]], [[DIM]]
; CHECK-NEXT:    br i1 [[M_DONE]], label %[[KLOOP_LATCH_LOOPEXIT:.*]], label %[[MLOOP]]
; CHECK:       [[KLOOP_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[KLOOP_LATCH]]
; CHECK:       [[KLOOP_LATCH]]:
; CHECK-NEXT:    [[KK_NEXT]] = add nuw nsw i32 [[KK]], 1
; CHECK-NEXT:    [[SCEVGEP4]] = getelementptr i8, ptr [[LSR_IV3]], i32 4
; CHECK-NEXT:    [[SCEVGEP9]] = getelementptr i8, ptr [[LSR_IV8]], i32 [[TMP1]]
; CHECK-NEXT:    [[K_DONE:%.*]] = icmp eq i32 [[KK_NEXT]], [[DIM]]
; CHECK-NEXT:    br i1 [[K_DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[KLOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %dim.pos = icmp sgt i32 %dim, 1
  br i1 %dim.pos, label %kloop, label %exit

kloop:
  %kk = phi i32 [ 0, %entry ], [ %kk.next, %kloop.latch ]
  %first = add nuw nsw i32 %kk, 1
  %has.rows = icmp slt i32 %first, %dim
  br i1 %has.rows, label %mloop, label %kloop.latch

mloop:
  %m = phi i32 [ %first, %kloop ], [ %m.next, %mloop.latch ]
  %row.off = mul nsw i32 %m, %dim
  %row = getelementptr inbounds float, ptr %mat, i32 %row.off
  br label %nloop

nloop:
  %n = phi i32 [ %first, %mloop ], [ %n.next, %nloop ]
  %pa = getelementptr inbounds float, ptr %row, i32 %n
  %pb = getelementptr inbounds float, ptr %pivrow, i32 %n
  %a = load float, ptr %pa, align 4
  %b = load float, ptr %pb, align 4
  %prod = fmul float %b, %f
  %r = fsub float %a, %prod
  store float %r, ptr %pa, align 4
  %n.next = add nuw nsw i32 %n, 1
  %n.done = icmp eq i32 %n.next, %dim
  br i1 %n.done, label %mloop.latch, label %nloop

mloop.latch:
  %m.next = add nuw nsw i32 %m, 1
  %m.done = icmp eq i32 %m.next, %dim
  br i1 %m.done, label %kloop.latch, label %mloop

kloop.latch:
  %kk.next = add nuw nsw i32 %kk, 1
  %k.done = icmp eq i32 %kk.next, %dim
  br i1 %k.done, label %exit, label %kloop

exit:
  ret void
}
