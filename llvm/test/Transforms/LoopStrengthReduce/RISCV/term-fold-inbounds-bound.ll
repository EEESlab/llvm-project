  %s = phi i32 [ 0, %entry ], [ %s.next, %loop ]
  %p = getelementptr inbounds i32, ptr %a, i32 %i
  %v = load i32, ptr %p
  %s.next = add i32 %s, %v
  %inc = add nsw i32 %i, 1
  %cmp = icmp slt i32 %inc, %end
  br i1 %cmp, label %loop, label %exit, !llvm.loop !0

exit:
  %r = phi i32 [ 0, %entry ], [ %s.next, %loop ]
