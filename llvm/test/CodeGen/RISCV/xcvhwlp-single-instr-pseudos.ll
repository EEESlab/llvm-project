; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -O3 -mtriple=riscv32 -mattr=+m,+c,+zfinx,+zhinx,+xcvsimd,+xcvhwlp \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; Pseudos that are expanded after the hardware-loop pass into exactly one
; 32-bit instruction with no compressed form are four bytes inside the no-RVC
; region, so they must not prevent a loop from becoming a hardware loop:
;  - PseudoMV_FPR32INX / PseudoMV_FPR16INX: zeroing a Zfinx/Zhinx accumulator
;    before an inner loop must not keep the outer loop a software loop;
;  - CV_SHUFFLE_SCI_B_PSEUDO: one cv.shufflei{0..3}.sci.b;
;  - ReadFRM/WriteFRM and ReadFFLAGS/WriteFFLAGS: one csrr* each.

define void @row_sums_f32(ptr %a, ptr %d, i32 %rows, i32 %n) {
; CHECK-LABEL: row_sums_f32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 0
; CHECK-NEXT:    slli a5, a3, 2
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 1, a2, .LBB0_4
; CHECK-NEXT:  # %bb.1: # %outer
; CHECK-NEXT:    li a6, 0
; CHECK-NEXT:    mv t0, a0
; CHECK-NEXT:    cv.setup 0, a3, .LBB0_3
; CHECK-NEXT:  # %bb.2: # %inner
; CHECK-NEXT:    lw t1, 0(t0)
; CHECK-NEXT:    fadd.s a6, a6, t1
; CHECK-NEXT:    addi t0, t0, 4
; CHECK-NEXT:  .LBB0_3: # %outer.latch
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    slli a7, a4, 2
; CHECK-NEXT:    add a7, a1, a7
; CHECK-NEXT:    sw a6, 0(a7)
; CHECK-NEXT:    add a0, a0, a5
; CHECK-NEXT:    addi a4, a4, 1
; CHECK-NEXT:  .LBB0_4: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  %stride = shl i32 %n, 2
  br label %outer

outer:
  %r = phi i32 [ 0, %entry ], [ %r.next, %outer.latch ]
  %row = phi ptr [ %a, %entry ], [ %row.next, %outer.latch ]
  br label %inner

inner:
  %k = phi i32 [ 0, %outer ], [ %k.next, %inner ]
  %acc = phi float [ 0.0, %outer ], [ %acc.next, %inner ]
  %p = getelementptr inbounds float, ptr %row, i32 %k
  %v = load float, ptr %p, align 4
  %acc.next = fadd fast float %acc, %v
  %k.next = add nuw nsw i32 %k, 1
  %inner.done = icmp eq i32 %k.next, %n
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %dp = getelementptr inbounds float, ptr %d, i32 %r
  store float %acc.next, ptr %dp, align 4
  %row.next = getelementptr inbounds i8, ptr %row, i32 %stride
  %r.next = add nuw nsw i32 %r, 1
  %outer.done = icmp eq i32 %r.next, %rows
  br i1 %outer.done, label %exit, label %outer

exit:
  ret void
}

define void @row_sums_f16(ptr %a, ptr %d, i32 %rows, i32 %n) {
; CHECK-LABEL: row_sums_f16:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 0
; CHECK-NEXT:    slli a5, a3, 1
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 1, a2, .LBB1_4
; CHECK-NEXT:  # %bb.1: # %outer
; CHECK-NEXT:    li a6, 0
; CHECK-NEXT:    mv t0, a0
; CHECK-NEXT:    cv.setup 0, a3, .LBB1_3
; CHECK-NEXT:  # %bb.2: # %inner
; CHECK-NEXT:    lh t1, 0(t0)
; CHECK-NEXT:    fadd.h a6, a6, t1
; CHECK-NEXT:    addi t0, t0, 2
; CHECK-NEXT:  .LBB1_3: # %outer.latch
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    slli a7, a4, 1
; CHECK-NEXT:    add a7, a1, a7
; CHECK-NEXT:    sh a6, 0(a7)
; CHECK-NEXT:    add a0, a0, a5
; CHECK-NEXT:    addi a4, a4, 1
; CHECK-NEXT:  .LBB1_4: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  %stride = shl i32 %n, 1
  br label %outer

outer:
  %r = phi i32 [ 0, %entry ], [ %r.next, %outer.latch ]
  %row = phi ptr [ %a, %entry ], [ %row.next, %outer.latch ]
  br label %inner

inner:
  %k = phi i32 [ 0, %outer ], [ %k.next, %inner ]
  %acc = phi half [ 0.0, %outer ], [ %acc.next, %inner ]
  %p = getelementptr inbounds half, ptr %row, i32 %k
  %v = load half, ptr %p, align 2
  %acc.next = fadd fast half %acc, %v
  %k.next = add nuw nsw i32 %k, 1
  %inner.done = icmp eq i32 %k.next, %n
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %dp = getelementptr inbounds half, ptr %d, i32 %r
  store half %acc.next, ptr %dp, align 2
  %row.next = getelementptr inbounds i8, ptr %row, i32 %stride
  %r.next = add nuw nsw i32 %r, 1
  %outer.done = icmp eq i32 %r.next, %rows
  br i1 %outer.done, label %exit, label %outer

exit:
  ret void
}

declare i32 @llvm.riscv.cv.simd.shuffle.sci.b(i32, i32)

define void @shuffle_sci_b(ptr %a, ptr %d, i32 %n) {
; CHECK-LABEL: shuffle_sci_b:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a2, .LBB2_2
; CHECK-NEXT:  # %bb.1: # %loop
; CHECK-NEXT:    lw a3, 0(a0)
; CHECK-NEXT:    cv.shufflei0.sci.b a3, a3, 27
; CHECK-NEXT:    sw a3, 0(a1)
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:  .LBB2_2: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %p = getelementptr inbounds i32, ptr %a, i32 %i
  %v = load i32, ptr %p, align 4
  %s = call i32 @llvm.riscv.cv.simd.shuffle.sci.b(i32 %v, i32 27)
  %q = getelementptr inbounds i32, ptr %d, i32 %i
  store i32 %s, ptr %q, align 4
  %i.next = add nuw nsw i32 %i, 1
  %c = icmp eq i32 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

declare void @llvm.set.rounding(i32)
declare i32 @llvm.get.rounding()

; The loop writes frm, so the read cannot be hoisted out of it either.
define void @rounding_mode(ptr %a, ptr %d, i32 %n) {
; CHECK-LABEL: rounding_mode:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a3, 0
; CHECK-NEXT:    lui a4, 66
; CHECK-NEXT:    addi a4, a4, 769
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a2, .LBB3_2
; CHECK-NEXT:  # %bb.1: # %loop
; CHECK-NEXT:    andi a5, a3, 3
; CHECK-NEXT:    slli a5, a5, 2
; CHECK-NEXT:    srl a5, a4, a5
; CHECK-NEXT:    andi a5, a5, 3
; CHECK-NEXT:    fsrm a5
; CHECK-NEXT:    lw a5, 0(a0)
; CHECK-NEXT:    frrm a6
; CHECK-NEXT:    slli a6, a6, 2
; CHECK-NEXT:    srl a6, a4, a6
; CHECK-NEXT:    andi a6, a6, 7
; CHECK-NEXT:    mul a5, a5, a6
; CHECK-NEXT:    addi a3, a3, 1
; CHECK-NEXT:    sw a5, 0(a1)
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:  .LBB3_2: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %m = and i32 %i, 3
  call void @llvm.set.rounding(i32 %m)
  %r = call i32 @llvm.get.rounding()
  %p = getelementptr inbounds i32, ptr %a, i32 %i
  %v = load i32, ptr %p, align 4
  %x = mul i32 %v, %r
  %q = getelementptr inbounds i32, ptr %d, i32 %i
  store i32 %x, ptr %q, align 4
  %i.next = add nuw nsw i32 %i, 1
  %c = icmp eq i32 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

declare i1 @llvm.experimental.constrained.fcmp.f32(float, float, metadata, metadata)

; A strict-FP quiet comparison saves and restores fflags around flt.
define void @quiet_fcmp(ptr %a, ptr %b, ptr %d, i32 %n) strictfp {
; CHECK-LABEL: quiet_fcmp:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a3, .LBB4_2
; CHECK-NEXT:  # %bb.1: # %loop
; CHECK-NEXT:    lw a4, 0(a0)
; CHECK-NEXT:    lw a5, 0(a1)
; CHECK-NEXT:    frflags a6
; CHECK-NEXT:    flt.s a7, a4, a5
; CHECK-NEXT:    fsflags a6
; CHECK-NEXT:    feq.s zero, a4, a5
; CHECK-NEXT:    sw a7, 0(a2)
; CHECK-NEXT:    addi a2, a2, 4
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:  .LBB4_2: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %pa = getelementptr inbounds float, ptr %a, i32 %i
  %va = load float, ptr %pa, align 4
  %pb = getelementptr inbounds float, ptr %b, i32 %i
  %vb = load float, ptr %pb, align 4
  %lt = call i1 @llvm.experimental.constrained.fcmp.f32(float %va, float %vb, metadata !"olt", metadata !"fpexcept.strict") strictfp
  %z = zext i1 %lt to i32
  %q = getelementptr inbounds i32, ptr %d, i32 %i
  store i32 %z, ptr %q, align 4
  %i.next = add nuw nsw i32 %i, 1
  %c = icmp eq i32 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}
