; With XCVbf, bf16 lives in GPRs, so the XCVmem halfword loads/stores
; (cv.lh/cv.sh) are used for bf16 just like for i16 and for f16 with Zhinx.

define { bfloat, ptr } @flh_ri_inc(ptr %a) {
; XCVBF-LABEL: flh_ri_inc:
; XCVBF:       # %bb.0:
; XCVBF-NEXT:    mv a1, a0
; XCVBF-NEXT:    cv.lh a0, (a1), 40
; XCVBF-NEXT:    # kill: def $x10_h killed $x10_h killed $x10
; XCVBF-NEXT:    ret
;
; NOXCVMEM-LABEL: flh_ri_inc:
; NOXCVMEM:       # %bb.0:
; NOXCVMEM-NEXT:    lh a2, 0(a0)
; NOXCVMEM-NEXT:    addi a1, a0, 40
; NOXCVMEM-NEXT:    mv a0, a2
; NOXCVMEM-NEXT:    ret
  %1 = load bfloat, ptr %a
  %2 = getelementptr i8, ptr %a, i32 40
  %3 = insertvalue { bfloat, ptr } poison, bfloat %1, 0
  %4 = insertvalue { bfloat, ptr } %3, ptr %2, 1
  ret { bfloat, ptr } %4
}

