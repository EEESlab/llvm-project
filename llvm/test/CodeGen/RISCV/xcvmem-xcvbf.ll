; An odd increment is not a multiple of the halfword size, so no
; post-increment form is used: plain sh + addi (same as for i16).
define ptr @fsh_ri_inc_odd(ptr %a, bfloat %b) {
; XCVBF-LABEL: fsh_ri_inc_odd:
; XCVBF:       # %bb.0:
; XCVBF-NEXT:    mv a2, a0
; XCVBF-NEXT:    addi a0, a0, 3
; XCVBF-NEXT:    sh a1, 0(a2)
; XCVBF-NEXT:    ret
;
; NOXCVMEM-LABEL: fsh_ri_inc_odd:
; NOXCVMEM:       # %bb.0:
; NOXCVMEM-NEXT:    mv a2, a0
; NOXCVMEM-NEXT:    addi a0, a0, 3
; NOXCVMEM-NEXT:    sh a1, 0(a2)
; NOXCVMEM-NEXT:    ret
  store bfloat %b, ptr %a
  %1 = getelementptr i8, ptr %a, i32 3
  ret ptr %1
}

; The real use case: dst[i] = a[i] + b[i].
define void @vadd(ptr %a, ptr %b, ptr %d, i32 %n) {
; XCVBF-LABEL: vadd:
; XCVBF:       # %bb.0: # %entry
; XCVBF-NEXT:    blez a3, .LBB7_3
; XCVBF-NEXT:  # %bb.1: # %loop.preheader
; XCVBF-NEXT:    slli a3, a3, 1
; XCVBF-NEXT:    add a3, a2, a3
; XCVBF-NEXT:  .LBB7_2: # %loop
; XCVBF-NEXT:    # =>This Inner Loop Header: Depth=1
; XCVBF-NEXT:    cv.lh a4, (a0), 2
; XCVBF-NEXT:    cv.lh a5, (a1), 2
; XCVBF-NEXT:    cv.fadd.bf16 a4, a4, a5
; XCVBF-NEXT:    cv.sh a4, (a2), 2
; XCVBF-NEXT:    bne a2, a3, .LBB7_2
; XCVBF-NEXT:  .LBB7_3: # %exit
; XCVBF-NEXT:    ret
;
; NOXCVMEM-LABEL: vadd:
; NOXCVMEM:       # %bb.0: # %entry
; NOXCVMEM-NEXT:    blez a3, .LBB7_3
; NOXCVMEM-NEXT:  # %bb.1: # %loop.preheader
; NOXCVMEM-NEXT:    slli a3, a3, 1
; NOXCVMEM-NEXT:    add a3, a2, a3
; NOXCVMEM-NEXT:  .LBB7_2: # %loop
; NOXCVMEM-NEXT:    # =>This Inner Loop Header: Depth=1
; NOXCVMEM-NEXT:    lh a4, 0(a0)
; NOXCVMEM-NEXT:    lh a5, 0(a1)
; NOXCVMEM-NEXT:    cv.fadd.bf16 a4, a4, a5
; NOXCVMEM-NEXT:    sh a4, 0(a2)
; NOXCVMEM-NEXT:    addi a2, a2, 2
; NOXCVMEM-NEXT:    addi a1, a1, 2
; NOXCVMEM-NEXT:    addi a0, a0, 2
; NOXCVMEM-NEXT:    bne a2, a3, .LBB7_2
; NOXCVMEM-NEXT:  .LBB7_3: # %exit
; NOXCVMEM-NEXT:    ret
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %inc, %loop ]
  %pa = getelementptr inbounds bfloat, ptr %a, i32 %i
  %va = load bfloat, ptr %pa
  %pb = getelementptr inbounds bfloat, ptr %b, i32 %i
  %vb = load bfloat, ptr %pb
  %s = fadd bfloat %va, %vb
  %pd = getelementptr inbounds bfloat, ptr %d, i32 %i
  store bfloat %s, ptr %pd
  %inc = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %inc, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

