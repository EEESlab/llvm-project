; RUN: llc -mtriple=riscv32 -mattr=+xcvmem,+xcvhwlp -mcpu=cv32e40p \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; A copy loop unrolled by two. The second load is selected as a post-increment
; cv.lw, which must keep the memory operand of the load: with src and dst
; noalias it is then scheduled before the first store, so neither store
; follows its load.

define void @copy2(ptr noalias %src, ptr noalias %dst, i32 %n) {
; CHECK-LABEL: copy2:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a3, 2
; CHECK-NEXT:    cv.maxu a2, a2, a3
; CHECK-NEXT:    li a3, -1
; CHECK-NEXT:    cv.addun a2, a2, a3, 1
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:    addi a2, a2, 1
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a2, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %loop
; CHECK-NEXT:    lw a3, -4(a0)
; CHECK-NEXT:    cv.lw a4, (a0), 8
; CHECK-NEXT:    sw a3, -4(a1)
; CHECK-NEXT:    cv.sw a4, (a1), 8
; CHECK-NEXT:  .LBB0_2: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ps0 = getelementptr inbounds i32, ptr %src, i32 %i
  %v0 = load i32, ptr %ps0, align 4
  %pd0 = getelementptr inbounds i32, ptr %dst, i32 %i
  store i32 %v0, ptr %pd0, align 4
  %i1 = or disjoint i32 %i, 1
  %ps1 = getelementptr inbounds i32, ptr %src, i32 %i1
  %v1 = load i32, ptr %ps1, align 4
  %pd1 = getelementptr inbounds i32, ptr %dst, i32 %i1
  store i32 %v1, ptr %pd1, align 4
  %i.next = add nuw nsw i32 %i, 2
  %done = icmp uge i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

