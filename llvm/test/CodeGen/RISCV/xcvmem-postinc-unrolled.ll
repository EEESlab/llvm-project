; RUN: llc -O3 -mtriple=riscv32 -mattr=+xcvmem,+zfinx -verify-machineinstrs < %s \
; RUN:   | FileCheck %s --check-prefixes=CHECK

; A 2x unrolled loop accesses p[-1] and p[0] (after LSR) and then does
; p += 2. The post-increment combine must still fire on one access per
; pointer, folding the pointer update; the other access keeps its reg+imm
; offset from the old pointer.

define void @vadd_unrolled_f32(ptr %a, ptr %b, ptr %d, i32 %start, i32 %n) {
; CHECK-LABEL: vadd_unrolled_f32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    slli a6, a3, 2
; CHECK-NEXT:    addi a5, a6, 4
; CHECK-NEXT:    bgtz a4, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %entry
; CHECK-NEXT:    li a4, 1
; CHECK-NEXT:  .LBB0_2: # %entry
; CHECK-NEXT:    add a3, a1, a5
; CHECK-NEXT:    slli a4, a4, 3
; CHECK-NEXT:    add a1, a6, a1
; CHECK-NEXT:    add a0, a0, a5
; CHECK-NEXT:    add a1, a4, a1
; CHECK-NEXT:    add a2, a2, a5
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:  .LBB0_3: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lw a4, -4(a0)
; CHECK-NEXT:    lw a5, -4(a3)
; CHECK-NEXT:    cv.lw a6, (a0), 8
; CHECK-NEXT:    cv.lw a7, (a3), 8
; CHECK-NEXT:    fadd.s a4, a4, a5
; CHECK-NEXT:    fadd.s a5, a6, a7
; CHECK-NEXT:    sw a4, -4(a2)
; CHECK-NEXT:    cv.sw a5, (a2), 8
; CHECK-NEXT:    bne a3, a1, .LBB0_3
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ %start, %entry ], [ %i.next, %loop ]
  %op = phi i32 [ 0, %entry ], [ %op.next, %loop ]
  %i1 = add nsw i32 %i, 1
  %pa0 = getelementptr inbounds float, ptr %a, i32 %i
  %a0 = load float, ptr %pa0, align 4
  %pb0 = getelementptr inbounds float, ptr %b, i32 %i
  %b0 = load float, ptr %pb0, align 4
  %pa1 = getelementptr inbounds float, ptr %a, i32 %i1
  %a1 = load float, ptr %pa1, align 4
  %pb1 = getelementptr inbounds float, ptr %b, i32 %i1
  %b1 = load float, ptr %pb1, align 4
  %s0 = fadd float %a0, %b0
  %pd0 = getelementptr inbounds float, ptr %d, i32 %i
  store float %s0, ptr %pd0, align 4
  %s1 = fadd float %a1, %b1
  %pd1 = getelementptr inbounds float, ptr %d, i32 %i1
  store float %s1, ptr %pd1, align 4
  %i.next = add nsw i32 %i, 2
  %op.next = add nuw nsw i32 %op, 1
  %cmp = icmp slt i32 %op.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

define void @vadd_unrolled_i32(ptr %a, ptr %b, ptr %d, i32 %n) {
; CHECK-LABEL: vadd_unrolled_i32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 2
; CHECK-NEXT:    bltu a4, a3, .LBB1_2
; CHECK-NEXT:  # %bb.1: # %entry
; CHECK-NEXT:    li a3, 2
; CHECK-NEXT:  .LBB1_2: # %entry
; CHECK-NEXT:    slli a3, a3, 2
; CHECK-NEXT:    addi a4, a3, -4
; CHECK-NEXT:    addi a3, a2, 4
; CHECK-NEXT:    andi a4, a4, -8
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:    add a2, a4, a2
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:    addi a2, a2, 12
; CHECK-NEXT:  .LBB1_3: # %loop
