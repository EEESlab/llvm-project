}

; 4x unrolled byte copy: p[0..3] then p += 4.
define void @copy_unrolled_i8(ptr %src, ptr %dst, i32 %n) {
; CHECK-LABEL: copy_unrolled_i8:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a3, 4
; CHECK-NEXT:    bltu a3, a2, .LBB2_2
; CHECK-NEXT:  # %bb.1: # %entry
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:  .LBB2_2: # %entry
; CHECK-NEXT:    addi a2, a2, -1
; CHECK-NEXT:    andi a3, a2, -4
; CHECK-NEXT:    addi a2, a1, 3
; CHECK-NEXT:    add a1, a3, a1
; CHECK-NEXT:    addi a0, a0, 3
; CHECK-NEXT:    addi a1, a1, 7
; CHECK-NEXT:  .LBB2_3: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lbu a3, -3(a0)
; CHECK-NEXT:    lbu a4, -2(a0)
; CHECK-NEXT:    lbu a5, -1(a0)
; CHECK-NEXT:    cv.lbu a6, (a0), 4
; CHECK-NEXT:    sb a3, -3(a2)
; CHECK-NEXT:    sb a4, -2(a2)
; CHECK-NEXT:    sb a5, -1(a2)
; CHECK-NEXT:    cv.sb a6, (a2), 4
; CHECK-NEXT:    bne a2, a1, .LBB2_3
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %s0 = getelementptr inbounds i8, ptr %src, i32 %i
  %v0 = load i8, ptr %s0
  %i1 = or disjoint i32 %i, 1
  %s1 = getelementptr inbounds i8, ptr %src, i32 %i1
  %v1 = load i8, ptr %s1
  %i2 = or disjoint i32 %i, 2
  %s2 = getelementptr inbounds i8, ptr %src, i32 %i2
  %v2 = load i8, ptr %s2
  %i3 = or disjoint i32 %i, 3
  %s3 = getelementptr inbounds i8, ptr %src, i32 %i3
  %v3 = load i8, ptr %s3
  %d0 = getelementptr inbounds i8, ptr %dst, i32 %i
  store i8 %v0, ptr %d0
  %d1 = getelementptr inbounds i8, ptr %dst, i32 %i1
  store i8 %v1, ptr %d1
  %d2 = getelementptr inbounds i8, ptr %dst, i32 %i2
  store i8 %v2, ptr %d2
  %d3 = getelementptr inbounds i8, ptr %dst, i32 %i3
  store i8 %v3, ptr %d3
  %i.next = add nuw nsw i32 %i, 4
  %cmp = icmp ult i32 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}
