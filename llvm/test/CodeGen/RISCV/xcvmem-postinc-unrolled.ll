; CHECK-NEXT:    add a6, a6, a7
; CHECK-NEXT:    sw a4, -4(a3)
; CHECK-NEXT:    cv.sw a6, (a3), 8
; CHECK-NEXT:    bne a3, a2, .LBB1_3
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %i1 = add nuw nsw i32 %i, 1
  %pa0 = getelementptr inbounds i32, ptr %a, i32 %i
  %a0 = load i32, ptr %pa0, align 4
  %pb0 = getelementptr inbounds i32, ptr %b, i32 %i
  %b0 = load i32, ptr %pb0, align 4
  %pa1 = getelementptr inbounds i32, ptr %a, i32 %i1
  %a1 = load i32, ptr %pa1, align 4
  %pb1 = getelementptr inbounds i32, ptr %b, i32 %i1
  %b1 = load i32, ptr %pb1, align 4
  %s0 = add i32 %a0, %b0
  %pd0 = getelementptr inbounds i32, ptr %d, i32 %i
  store i32 %s0, ptr %pd0, align 4
  %s1 = add i32 %a1, %b1
  %pd1 = getelementptr inbounds i32, ptr %d, i32 %i1
  store i32 %s1, ptr %pd1, align 4
  %i.next = add nuw nsw i32 %i, 2
  %cmp = icmp ult i32 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
