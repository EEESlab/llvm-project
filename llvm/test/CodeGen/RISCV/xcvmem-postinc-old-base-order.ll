; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -O3 -mtriple=riscv32 -mattr=+m,+xcvmem,+zfinx -verify-machineinstrs < %s \
; RUN:   | FileCheck %s --check-prefixes=CHECK

; When the post-increment combine fires on one access of a pointer while
; another access still addresses from the old pointer value, that access must
; be emitted before the post-increment. Otherwise the old value is live across
; the tied write-back and the two-address pass inserts a copy ("mv") in the
; loop.

; Matrix-multiply inner loop, 2x unrolled. Column accesses of %b at p and
; p + %stride are loaded in source order p first, so without explicit
; ordering the reg+reg load from the old base would be emitted after the
; post-increment.
define float @dot_column_unrolled(ptr %a, ptr %b, i32 %stride, i32 %n) {
; CHECK-LABEL: dot_column_unrolled:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 0
; CHECK-NEXT:    li a5, 0
; CHECK-NEXT:    addi a6, a3, -1
; CHECK-NEXT:    srai a7, a6, 31
; CHECK-NEXT:    and a6, a7, a6
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:    slli a3, a3, 3
; CHECK-NEXT:    slli a6, a6, 3
; CHECK-NEXT:    add a3, a0, a3
; CHECK-NEXT:    sub a3, a3, a6
; CHECK-NEXT:    slli a6, a2, 3
; CHECK-NEXT:    slli a2, a2, 2
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lw a7, -4(a0)
; CHECK-NEXT:    cv.lw t0, (a0), 8
; CHECK-NEXT:    cv.lw t1, a2(a1)
; CHECK-NEXT:    cv.lw t2, (a1), a6
; CHECK-NEXT:    fmadd.s a4, a7, t2, a4
; CHECK-NEXT:    fmadd.s a5, t0, t1, a5
; CHECK-NEXT:    bne a0, a3, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    fadd.s a0, a4, a5
; CHECK-NEXT:    ret
entry:
  %stride2 = shl i32 %stride, 1
  br label %loop

loop:
  %k = phi i32 [ 0, %entry ], [ %k.next, %loop ]
  %ib = phi i32 [ 0, %entry ], [ %ib.next, %loop ]
  %ops = phi i32 [ %n, %entry ], [ %ops.next, %loop ]
  %s1 = phi float [ 0.0, %entry ], [ %s1.next, %loop ]
  %s2 = phi float [ 0.0, %entry ], [ %s2.next, %loop ]
  %k1 = add nsw i32 %k, 1
  %ib1 = add nsw i32 %ib, %stride
  %pa0 = getelementptr inbounds float, ptr %a, i32 %k
  %a0 = load float, ptr %pa0, align 4
  %pa1 = getelementptr inbounds float, ptr %a, i32 %k1
  %a1 = load float, ptr %pa1, align 4
  %pb0 = getelementptr inbounds float, ptr %b, i32 %ib
  %b0 = load float, ptr %pb0, align 4
  %pb1 = getelementptr inbounds float, ptr %b, i32 %ib1
  %b1 = load float, ptr %pb1, align 4
  %m1 = fmul contract float %a0, %b0
  %s1.next = fadd contract float %s1, %m1
  %m2 = fmul contract float %a1, %b1
  %s2.next = fadd contract float %s2, %m2
  %k.next = add nsw i32 %k, 2
  %ib.next = add nsw i32 %ib, %stride2
  %ops.next = add nsw i32 %ops, -1
  %cmp = icmp sgt i32 %ops.next, 0
  br i1 %cmp, label %loop, label %exit

exit:
  %r = fadd float %s1.next, %s2.next
  ret float %r
}

; Same shape with integer data, so the reg+reg access is an i32 load.
define i32 @dot_column_unrolled_i32(ptr %a, ptr %b, i32 %stride, i32 %n) {
; CHECK-LABEL: dot_column_unrolled_i32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 0
; CHECK-NEXT:    li a5, 0
; CHECK-NEXT:    addi a6, a3, -1
; CHECK-NEXT:    srai a7, a6, 31
; CHECK-NEXT:    and a6, a7, a6
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:    slli a3, a3, 3
; CHECK-NEXT:    slli a6, a6, 3
; CHECK-NEXT:    add a3, a0, a3
; CHECK-NEXT:    sub a3, a3, a6
; CHECK-NEXT:    slli a6, a2, 3
; CHECK-NEXT:    slli a2, a2, 2
; CHECK-NEXT:  .LBB1_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lw a7, -4(a0)
; CHECK-NEXT:    cv.lw t0, (a0), 8
; CHECK-NEXT:    cv.lw t1, a2(a1)
; CHECK-NEXT:    cv.lw t2, (a1), a6
; CHECK-NEXT:    mul a7, a7, t2
; CHECK-NEXT:    mul t0, t0, t1
; CHECK-NEXT:    add a4, a4, a7
; CHECK-NEXT:    add a5, a5, t0
; CHECK-NEXT:    bne a0, a3, .LBB1_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    add a0, a4, a5
; CHECK-NEXT:    ret
entry:
  %stride2 = shl i32 %stride, 1
  br label %loop

loop:
  %k = phi i32 [ 0, %entry ], [ %k.next, %loop ]
  %ib = phi i32 [ 0, %entry ], [ %ib.next, %loop ]
  %ops = phi i32 [ %n, %entry ], [ %ops.next, %loop ]
  %s1 = phi i32 [ 0, %entry ], [ %s1.next, %loop ]
  %s2 = phi i32 [ 0, %entry ], [ %s2.next, %loop ]
  %k1 = add nsw i32 %k, 1
  %ib1 = add nsw i32 %ib, %stride
  %pa0 = getelementptr inbounds i32, ptr %a, i32 %k
  %a0 = load i32, ptr %pa0, align 4
  %pa1 = getelementptr inbounds i32, ptr %a, i32 %k1
  %a1 = load i32, ptr %pa1, align 4
  %pb0 = getelementptr inbounds i32, ptr %b, i32 %ib
  %b0 = load i32, ptr %pb0, align 4
  %pb1 = getelementptr inbounds i32, ptr %b, i32 %ib1
  %b1 = load i32, ptr %pb1, align 4
  %m1 = mul i32 %a0, %b0
  %s1.next = add i32 %s1, %m1
  %m2 = mul i32 %a1, %b1
  %s2.next = add i32 %s2, %m2
  %k.next = add nsw i32 %k, 2
  %ib.next = add nsw i32 %ib, %stride2
  %ops.next = add nsw i32 %ops, -1
  %cmp = icmp sgt i32 %ops.next, 0
  br i1 %cmp, label %loop, label %exit

exit:
  %r = add i32 %s1.next, %s2.next
  ret i32 %r
}
