  %r = fptrunc <2 x float> %e to <2 x bfloat>
  ret <2 x bfloat> %r
}

define <2 x half> @v2bf16_to_v2f16(<2 x bfloat> %a) {
; CHECK-LABEL: v2bf16_to_v2f16:
