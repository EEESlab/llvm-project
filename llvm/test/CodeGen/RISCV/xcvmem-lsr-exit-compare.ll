; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv32 -mattr=+m,+xcvmem -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; The index of the last negative element. The index is needed as a value, so
; the loop can exit on "i + 1 == n" with a single IV: the branch compares two
; registers and needs no separate compare. Without that information LSR
; added a second IV counting down to zero for the exit test.

define i32 @last_neg(ptr %v, i32 %n) {
; CHECK-LABEL: last_neg:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    blez a1, .LBB0_5
; CHECK-NEXT:  # %bb.1: # %loop.preheader
; CHECK-NEXT:    li a2, 0
; CHECK-NEXT:    slli a1, a1, 2
; CHECK-NEXT:    add a3, a0, a1
; CHECK-NEXT:    li a1, -1
; CHECK-NEXT:    j .LBB0_3
; CHECK-NEXT:  .LBB0_2: # %loop
; CHECK-NEXT:    # in Loop: Header=BB0_3 Depth=1
; CHECK-NEXT:    addi a2, a2, 1
; CHECK-NEXT:    beq a0, a3, .LBB0_6
; CHECK-NEXT:  .LBB0_3: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cv.lw a4, (a0), 4
; CHECK-NEXT:    bgez a4, .LBB0_2
; CHECK-NEXT:  # %bb.4: # %loop
; CHECK-NEXT:    # in Loop: Header=BB0_3 Depth=1
; CHECK-NEXT:    mv a1, a2
; CHECK-NEXT:    j .LBB0_2
; CHECK-NEXT:  .LBB0_5:
; CHECK-NEXT:    li a1, -1
; CHECK-NEXT:  .LBB0_6: # %exit
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:    ret
entry:
  %cmp0 = icmp sgt i32 %n, 0
  br i1 %cmp0, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %r = phi i32 [ -1, %entry ], [ %r.next, %loop ]
  %p = getelementptr inbounds i32, ptr %v, i32 %i
  %x = load i32, ptr %p, align 4
  %neg = icmp slt i32 %x, 0
  %r.next = select i1 %neg, i32 %i, i32 %r
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  %res = phi i32 [ -1, %entry ], [ %r.next, %loop ]
  ret i32 %res
}

; The same search starting at k + 1, with a strided access.
define i32 @argmax_col(ptr %a, i32 %k, i32 %m, i32 %stride) {
; CHECK-LABEL: argmax_col:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi a4, a1, 1
; CHECK-NEXT:    bge a4, a2, .LBB1_5
; CHECK-NEXT:  # %bb.1: # %loop.preheader
; CHECK-NEXT:    li a5, 0
; CHECK-NEXT:    mul a6, a3, a4
; CHECK-NEXT:    slli a6, a6, 2
; CHECK-NEXT:    add a0, a0, a6
; CHECK-NEXT:    slli a3, a3, 2
; CHECK-NEXT:    j .LBB1_3
; CHECK-NEXT:  .LBB1_2: # %loop
; CHECK-NEXT:    # in Loop: Header=BB1_3 Depth=1
; CHECK-NEXT:    addi a4, a4, 1
; CHECK-NEXT:    beq a2, a4, .LBB1_5
; CHECK-NEXT:  .LBB1_3: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cv.lw a6, (a0), a3
; CHECK-NEXT:    bge a5, a6, .LBB1_2
; CHECK-NEXT:  # %bb.4: # %loop
; CHECK-NEXT:    # in Loop: Header=BB1_3 Depth=1
; CHECK-NEXT:    mv a5, a6
; CHECK-NEXT:    mv a1, a4
; CHECK-NEXT:    j .LBB1_2
; CHECK-NEXT:  .LBB1_5: # %exit
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:    ret
entry:
  %k1 = add nsw i32 %k, 1
  %cmp0 = icmp slt i32 %k1, %m
  br i1 %cmp0, label %loop, label %exit

loop:
  %i = phi i32 [ %k1, %entry ], [ %i.next, %loop ]
  %best = phi i32 [ %k, %entry ], [ %best.next, %loop ]
  %max = phi i32 [ 0, %entry ], [ %max.next, %loop ]
  %off = mul nsw i32 %i, %stride
  %p = getelementptr inbounds i32, ptr %a, i32 %off
  %x = load i32, ptr %p, align 4
  %gt = icmp sgt i32 %x, %max
  %max.next = select i1 %gt, i32 %x, i32 %max
  %best.next = select i1 %gt, i32 %i, i32 %best
  %i.next = add nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %m
  br i1 %done, label %exit, label %loop

exit:
  %res = phi i32 [ %k, %entry ], [ %best.next, %loop ]
  ret i32 %res
}
