; With XCVmem, LSR also processes outer loops, rewriting only the load/store
; addresses in the outer loop's own blocks. IV users inside subloops, the
; exit compare and other arithmetic are left untouched.

; The result of each inner reduction is stored to d[r] after the inner loop.
; With outer-loop LSR the store gets its own pointer IV and becomes a
; post-increment cv.sw; without it, it keeps the integer index r and needs a
; shift for the address and an add for r.
define void @row_sums(ptr %a, ptr %d, i32 %rows, i32 %n) {
; XCV-LABEL: row_sums:
; XCV:       # %bb.0: # %entry
; XCV-NEXT:    li a4, 0
; XCV-NEXT:    slli a3, a3, 2
; XCV-NEXT:    add a5, a0, a3
; XCV-NEXT:  .LBB0_1: # %outer
; XCV-NEXT:    # =>This Loop Header: Depth=1
; XCV-NEXT:    # Child Loop BB0_2 Depth 2
; XCV-NEXT:    li a6, 0
; XCV-NEXT:    mul a7, a3, a4
; XCV-NEXT:    add a7, a5, a7
; XCV-NEXT:    mv t0, a0
; XCV-NEXT:  .LBB0_2: # %inner
; XCV-NEXT:    # Parent Loop BB0_1 Depth=1
; XCV-NEXT:    # => This Inner Loop Header: Depth=2
; XCV-NEXT:    cv.lw t1, (t0), 4
; XCV-NEXT:    fadd.s a6, a6, t1
; XCV-NEXT:    bne t0, a7, .LBB0_2
; XCV-NEXT:  # %bb.3: # %outer.latch
; XCV-NEXT:    # in Loop: Header=BB0_1 Depth=1
; XCV-NEXT:    addi a4, a4, 1
; XCV-NEXT:    cv.sw a6, (a1), 4
; XCV-NEXT:    add a0, a0, a3
; XCV-NEXT:    bne a4, a2, .LBB0_1
; XCV-NEXT:  # %bb.4: # %exit
; XCV-NEXT:    ret
;
; NOXCV-LABEL: row_sums:
; NOXCV:       # %bb.0: # %entry
; NOXCV-NEXT:    li a4, 0
; NOXCV-NEXT:    slli a3, a3, 2
; NOXCV-NEXT:    add a5, a0, a3
; NOXCV-NEXT:  .LBB0_1: # %outer
; NOXCV-NEXT:    # =>This Loop Header: Depth=1
; NOXCV-NEXT:    # Child Loop BB0_2 Depth 2
; NOXCV-NEXT:    li a6, 0
; NOXCV-NEXT:    mul a7, a3, a4
; NOXCV-NEXT:    add a7, a5, a7
; NOXCV-NEXT:    mv t0, a0
; NOXCV-NEXT:  .LBB0_2: # %inner
; NOXCV-NEXT:    # Parent Loop BB0_1 Depth=1
; NOXCV-NEXT:    # => This Inner Loop Header: Depth=2
; NOXCV-NEXT:    lw t1, 0(t0)
; NOXCV-NEXT:    fadd.s a6, a6, t1
; NOXCV-NEXT:    addi t0, t0, 4
; NOXCV-NEXT:    bne t0, a7, .LBB0_2
; NOXCV-NEXT:  # %bb.3: # %outer.latch
; NOXCV-NEXT:    # in Loop: Header=BB0_1 Depth=1
; NOXCV-NEXT:    slli a7, a4, 2
; NOXCV-NEXT:    addi a4, a4, 1
; NOXCV-NEXT:    add a7, a1, a7
; NOXCV-NEXT:    sw a6, 0(a7)
; NOXCV-NEXT:    add a0, a0, a3
; NOXCV-NEXT:    bne a4, a2, .LBB0_1
; NOXCV-NEXT:  # %bb.4: # %exit
; NOXCV-NEXT:    ret
entry:
  %stride = shl i32 %n, 2
  br label %outer

outer:
  %r = phi i32 [ 0, %entry ], [ %r.next, %outer.latch ]
  %row = phi ptr [ %a, %entry ], [ %row.next, %outer.latch ]
  br label %inner

inner:
  %k = phi i32 [ 0, %outer ], [ %k.next, %inner ]
  %acc = phi float [ 0.0, %outer ], [ %acc.next, %inner ]
  %p = getelementptr inbounds float, ptr %row, i32 %k
  %v = load float, ptr %p, align 4
  %acc.next = fadd fast float %acc, %v
  %k.next = add nuw nsw i32 %k, 1
  %inner.done = icmp eq i32 %k.next, %n
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %dp = getelementptr inbounds float, ptr %d, i32 %r
  store float %acc.next, ptr %dp, align 4
  %row.next = getelementptr inbounds i8, ptr %row, i32 %stride
  %r.next = add nuw nsw i32 %r, 1
  %outer.done = icmp eq i32 %r.next, %rows
  br i1 %outer.done, label %exit, label %outer

exit:
  ret void
}

; The outer IV m is used only inside the inner loop: a[m] is loaded there (it
; is not hoisted, the inner loop may store to it). Outer-loop LSR must leave
; that use to the inner loop, and the inner loop must not get worse, e.g.
; with a copy of an outer pointer bumped by a post-increment in every inner
; iteration.
define void @row_scale_acc(ptr %a, ptr %b, ptr %d, i32 %rows, i32 %cols) {
; XCV-LABEL: row_scale_acc:
; XCV:       # %bb.0: # %entry
; XCV-NEXT:    li a5, 0
; XCV-NEXT:    slli a4, a4, 2
; XCV-NEXT:    add a6, a1, a4
; XCV-NEXT:  .LBB1_1: # %outer
; XCV-NEXT:    # =>This Loop Header: Depth=1
; XCV-NEXT:    # Child Loop BB1_2 Depth 2
; XCV-NEXT:    slli a7, a5, 2
; XCV-NEXT:    mv t0, a1
; XCV-NEXT:    mv t1, a2
; XCV-NEXT:  .LBB1_2: # %inner
; XCV-NEXT:    # Parent Loop BB1_1 Depth=1
; XCV-NEXT:    # => This Inner Loop Header: Depth=2
; XCV-NEXT:    cv.lw t2, a7(a0)
; XCV-NEXT:    cv.lw t3, (t0), 4
; XCV-NEXT:    lw t4, 0(t1)
; XCV-NEXT:    fmadd.s t2, t2, t3, t4
; XCV-NEXT:    cv.sw t2, (t1), 4
; XCV-NEXT:    bne t0, a6, .LBB1_2
; XCV-NEXT:  # %bb.3: # %outer.latch
; XCV-NEXT:    # in Loop: Header=BB1_1 Depth=1
; XCV-NEXT:    addi a5, a5, 1
; XCV-NEXT:    add a2, a2, a4
; XCV-NEXT:    bne a5, a3, .LBB1_1
; XCV-NEXT:  # %bb.4: # %exit
; XCV-NEXT:    ret
;
; NOXCV-LABEL: row_scale_acc:
; NOXCV:       # %bb.0: # %entry
; NOXCV-NEXT:    li a5, 0
; NOXCV-NEXT:    slli a4, a4, 2
; NOXCV-NEXT:    add a6, a1, a4
; NOXCV-NEXT:  .LBB1_1: # %outer
; NOXCV-NEXT:    # =>This Loop Header: Depth=1
; NOXCV-NEXT:    # Child Loop BB1_2 Depth 2
; NOXCV-NEXT:    slli a7, a5, 2
; NOXCV-NEXT:    add a7, a0, a7
; NOXCV-NEXT:    mv t0, a1
; NOXCV-NEXT:    mv t1, a2
; NOXCV-NEXT:  .LBB1_2: # %inner
; NOXCV-NEXT:    # Parent Loop BB1_1 Depth=1
; NOXCV-NEXT:    # => This Inner Loop Header: Depth=2
; NOXCV-NEXT:    lw t2, 0(a7)
; NOXCV-NEXT:    lw t3, 0(t0)
; NOXCV-NEXT:    lw t4, 0(t1)
; NOXCV-NEXT:    fmadd.s t2, t2, t3, t4
; NOXCV-NEXT:    addi t0, t0, 4
; NOXCV-NEXT:    sw t2, 0(t1)
; NOXCV-NEXT:    addi t1, t1, 4
; NOXCV-NEXT:    bne t0, a6, .LBB1_2
; NOXCV-NEXT:  # %bb.3: # %outer.latch
; NOXCV-NEXT:    # in Loop: Header=BB1_1 Depth=1
; NOXCV-NEXT:    addi a5, a5, 1
; NOXCV-NEXT:    add a2, a2, a4
; NOXCV-NEXT:    bne a5, a3, .LBB1_1
; NOXCV-NEXT:  # %bb.4: # %exit
; NOXCV-NEXT:    ret
entry:
  br label %outer

outer:
  %m = phi i32 [ 0, %entry ], [ %m.next, %outer.latch ]
  %drow.off = mul nsw i32 %m, %cols
  br label %inner

inner:
  %p = phi i32 [ 0, %outer ], [ %p.next, %inner ]
  %pa = getelementptr inbounds float, ptr %a, i32 %m
  %va = load float, ptr %pa, align 4
  %pb = getelementptr inbounds float, ptr %b, i32 %p
  %vb = load float, ptr %pb, align 4
  %di = add nsw i32 %drow.off, %p
  %pd = getelementptr inbounds float, ptr %d, i32 %di
  %vd = load float, ptr %pd, align 4
  %mul = fmul fast float %va, %vb
  %sum = fadd fast float %vd, %mul
  store float %sum, ptr %pd, align 4
  %p.next = add nuw nsw i32 %p, 1
  %inner.done = icmp eq i32 %p.next, %cols
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %m.next = add nuw nsw i32 %m, 1
  %outer.done = icmp eq i32 %m.next, %rows
  br i1 %outer.done, label %exit, label %outer

exit:
  ret void
}
