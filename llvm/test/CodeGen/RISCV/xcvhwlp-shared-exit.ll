; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -O3 -mtriple=riscv32 -mattr=+m,+xcvhwlp -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; Two hardware loops on different paths exit to the same block (the function
; epilogue). The exit block can follow only one latch, so the second loop
; converted gets its own lpend block that jumps to the shared exit. Moving the
; shared exit again would detach it from the first loop and leave a jump at
; the end of that loop's body ("loop offset out of range" at assembly time).

define void @shared_exit(ptr %a, ptr %b, i32 %n, i1 %c) {
; CHECK-LABEL: shared_exit:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    blez a2, .LBB0_4
; CHECK-NEXT:  # %bb.1: # %choose
; CHECK-NEXT:    andi a3, a3, 1
; CHECK-NEXT:    beqz a3, .LBB0_5
; CHECK-NEXT:  # %bb.2: # %loop1.preheader
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a2, .LBB0_4
; CHECK-NEXT:  # %bb.3: # %loop1
; CHECK-NEXT:    lw a1, 0(a0)
; CHECK-NEXT:    slli a3, a1, 1
; CHECK-NEXT:    add a1, a3, a1
; CHECK-NEXT:    addi a1, a1, 7
; CHECK-NEXT:    sw a1, 0(a0)
; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:  .LBB0_4: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_5: # %loop2.preheader
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a2, .LBB0_7
; CHECK-NEXT:  # %bb.6: # %loop2
; CHECK-NEXT:    lw a0, 0(a1)
; CHECK-NEXT:    slli a3, a0, 2
; CHECK-NEXT:    add a0, a3, a0
; CHECK-NEXT:    xori a0, a0, 9
; CHECK-NEXT:    sw a0, 0(a1)
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:  .LBB0_7: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    j .LBB0_4
entry:
  %pos = icmp sgt i32 %n, 0
  br i1 %pos, label %choose, label %exit

choose:
  br i1 %c, label %loop1, label %loop2

loop1:
  %i1 = phi i32 [ 0, %choose ], [ %i1.next, %loop1 ]
  %p1 = getelementptr inbounds i32, ptr %a, i32 %i1
  %v1 = load volatile i32, ptr %p1
  %m1 = mul i32 %v1, 3
  %s1 = add i32 %m1, 7
  store volatile i32 %s1, ptr %p1
  %i1.next = add nuw nsw i32 %i1, 1
  %d1 = icmp eq i32 %i1.next, %n
  br i1 %d1, label %exit, label %loop1

loop2:
  %i2 = phi i32 [ 0, %choose ], [ %i2.next, %loop2 ]
  %p2 = getelementptr inbounds i32, ptr %b, i32 %i2
  %v2 = load volatile i32, ptr %p2
  %m2 = mul i32 %v2, 5
  %s2 = xor i32 %m2, 9
  store volatile i32 %s2, ptr %p2
  %i2.next = add nuw nsw i32 %i2, 1
  %d2 = icmp eq i32 %i2.next, %n
  br i1 %d2, label %exit, label %loop2

exit:
  ret void
}
