; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -O3 -mtriple=riscv32 -mattr=+xcvmem,+zfinx -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; A constant post-increment that is not a multiple of the access size must not
; form an XCVmem post-increment access: it would leave the pointer misaligned
; for the next access. For loads this used to crash with "Cannot select"
; because the selector rejected the immediate and nothing else matched.

define { i32, ptr } @lw_inc2(ptr %p) {
; CHECK-LABEL: lw_inc2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw a2, 0(a0)
; CHECK-NEXT:    addi a1, a0, 2
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %v = load i32, ptr %p, align 4
  %q = getelementptr i8, ptr %p, i32 2
  %r0 = insertvalue { i32, ptr } poison, i32 %v, 0
  %r1 = insertvalue { i32, ptr } %r0, ptr %q, 1
  ret { i32, ptr } %r1
}

define { i32, ptr } @lh_inc1(ptr %p) {
; CHECK-LABEL: lh_inc1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lh a2, 0(a0)
; CHECK-NEXT:    addi a1, a0, 1
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %v = load i16, ptr %p, align 2
  %s = sext i16 %v to i32
  %q = getelementptr i8, ptr %p, i32 1
  %r0 = insertvalue { i32, ptr } poison, i32 %s, 0
  %r1 = insertvalue { i32, ptr } %r0, ptr %q, 1
  ret { i32, ptr } %r1
}

define { float, ptr } @flw_inc2(ptr %p) {
; CHECK-LABEL: flw_inc2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw a2, 0(a0)
; CHECK-NEXT:    addi a1, a0, 6
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %v = load float, ptr %p, align 4
  %q = getelementptr i8, ptr %p, i32 6
  %r0 = insertvalue { float, ptr } poison, float %v, 0
  %r1 = insertvalue { float, ptr } %r0, ptr %q, 1
  ret { float, ptr } %r1
}

define ptr @sw_inc2(ptr %p, i32 %v) {
; CHECK-LABEL: sw_inc2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mv a2, a0
; CHECK-NEXT:    addi a0, a0, 2
; CHECK-NEXT:    sw a1, 0(a2)
; CHECK-NEXT:    ret
  store i32 %v, ptr %p, align 4
  %q = getelementptr i8, ptr %p, i32 2
  ret ptr %q
}

define ptr @sh_inc3(ptr %p, i16 %v) {
; CHECK-LABEL: sh_inc3:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mv a2, a0
; CHECK-NEXT:    addi a0, a0, 3
; CHECK-NEXT:    sh a1, 0(a2)
; CHECK-NEXT:    ret
  store i16 %v, ptr %p, align 2
  %q = getelementptr i8, ptr %p, i32 3
  ret ptr %q
}

; Control: an aligned increment still uses the post-increment form.
define { i32, ptr } @lw_inc4(ptr %p) {
; CHECK-LABEL: lw_inc4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mv a1, a0
; CHECK-NEXT:    cv.lw a0, (a1), 4
; CHECK-NEXT:    ret
  %v = load i32, ptr %p, align 4
  %q = getelementptr i8, ptr %p, i32 4
  %r0 = insertvalue { i32, ptr } poison, i32 %v, 0
  %r1 = insertvalue { i32, ptr } %r0, ptr %q, 1
  ret { i32, ptr } %r1
}

; The loop shape from the original crash: 32-bit loads, pointer += 2.
define void @lw_loop_inc2(ptr %p, ptr %d, i32 %n) {
; CHECK-LABEL: lw_loop_inc2:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a3, 0
; CHECK-NEXT:  .LBB6_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lw a4, 0(a0)
; CHECK-NEXT:    addi a3, a3, 1
; CHECK-NEXT:    cv.sw a4, (a1), 4
; CHECK-NEXT:    addi a0, a0, 2
; CHECK-NEXT:    bltu a3, a2, .LBB6_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %pp = phi ptr [ %p, %entry ], [ %pp.next, %loop ]
  %pd = phi ptr [ %d, %entry ], [ %pd.next, %loop ]
  %v = load i32, ptr %pp, align 4
  store i32 %v, ptr %pd, align 4
  %pp.next = getelementptr i8, ptr %pp, i32 2
  %pd.next = getelementptr i8, ptr %pd, i32 4
  %i.next = add i32 %i, 1
  %c = icmp ult i32 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}
