; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -O3 -mtriple=riscv32 -mattr=+m,+xcvhwlp,+xcvbi,+xcvmem -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; The bodies below are shorter than the three instructions a CORE-V hardware
; loop needs, so the loop stays a software loop. LSR leaves a second countdown
; next to the loop-end pseudo; the two must be folded into a single counter
; instead of emitting "mv; addi; addi" every iteration.

define void @fill(ptr %d, i32 %v, i32 %n) {
; CHECK-LABEL: fill:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    bgtz a2, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %entry
; CHECK-NEXT:    li a2, 1
; CHECK-NEXT:  .LBB0_2: # %entry
; CHECK-NEXT:  .LBB0_3: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cv.sw a1, (a0), 4
; CHECK-NEXT:    addi a2, a2, -1
; CHECK-NEXT:    cv.bneimm a2, 0, .LBB0_3
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    ret
entry:
  %cnt = call i32 @llvm.smax.i32(i32 %n, i32 1)
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %p = getelementptr inbounds i32, ptr %d, i32 %i
  store i32 %v, ptr %p, align 4
  %i.next = add nuw nsw i32 %i, 1
  %c = icmp slt i32 %i.next, %cnt
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

define i32 @sum(ptr %s, i32 %n) {
; CHECK-LABEL: sum:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    bgtz a1, .LBB1_2
; CHECK-NEXT:  # %bb.1: # %entry
; CHECK-NEXT:    li a1, 1
; CHECK-NEXT:  .LBB1_2: # %entry
; CHECK-NEXT:    li a2, 0
; CHECK-NEXT:  .LBB1_3: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cv.lw a3, (a0), 4
; CHECK-NEXT:    addi a1, a1, -1
; CHECK-NEXT:    add a2, a2, a3
; CHECK-NEXT:    cv.bneimm a1, 0, .LBB1_3
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
entry:
  %cnt = call i32 @llvm.smax.i32(i32 %n, i32 1)
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %p = getelementptr inbounds i32, ptr %s, i32 %i
  %x = load i32, ptr %p, align 4
  %acc.next = add i32 %acc, %x
  %i.next = add nuw nsw i32 %i, 1
  %c = icmp slt i32 %i.next, %cnt
  br i1 %c, label %loop, label %exit

exit:
  ret i32 %acc.next
}

declare i32 @llvm.smax.i32(i32, i32)
