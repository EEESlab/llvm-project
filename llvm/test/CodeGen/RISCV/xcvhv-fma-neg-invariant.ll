; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -mtriple=riscv32 -mattr=+zhinx,+xcvhv,+xcvbfv,+xcvmem,+xcvhwlp \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; m[j] -= f * k[j] on packed half / bfloat, with f computed before the loop.
; There is no fused form for z - x * y: it is cv.vfmac with one factor
; negated. The factor defined outside the loop is negated, once, before the
; loop, so the loop body has no sign flip.

define void @sub_mul_half(ptr noalias %m, ptr noalias %k, <2 x half> %f, i32 %n) {
; CHECK-LABEL: sub_mul_half:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    cv.vfsgnjn.h a2, a2, a2
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a3, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %loop
; CHECK-NEXT:    lw a4, 0(a0)
; CHECK-NEXT:    cv.lw a5, (a1), 4
; CHECK-NEXT:    cv.vfmac.h a4, a5, a2
; CHECK-NEXT:    cv.sw a4, (a0), 4
; CHECK-NEXT:  .LBB0_2: # %exit
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %j = phi i32 [ 0, %entry ], [ %j.next, %loop ]
  %pk = getelementptr inbounds <2 x half>, ptr %k, i32 %j
  %vk = load <2 x half>, ptr %pk, align 4
  %pm = getelementptr inbounds <2 x half>, ptr %m, i32 %j
  %vm = load <2 x half>, ptr %pm, align 4
  %mul = fmul fast <2 x half> %vk, %f
  %sub = fsub fast <2 x half> %vm, %mul
  store <2 x half> %sub, ptr %pm, align 4
  %j.next = add nuw nsw i32 %j, 1
  %done = icmp eq i32 %j.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

