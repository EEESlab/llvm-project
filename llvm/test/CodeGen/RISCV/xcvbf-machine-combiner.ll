; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv32 -mattr=+zhinx,+xcvbf -O3 -verify-machineinstrs \
; RUN:   -riscv-enable-machine-combiner=true < %s | FileCheck %s

; The MachineCombiner reassociates chains of the XCVbf scalar instructions as
; it does for Zhinx: min/max always, add/mul with reassoc and nsz, so that a
; reduction is not a single chain of dependent instructions; and it fuses
; fmul + fadd/fsub with contract into cv.fmadd/cv.fmsub/cv.fnmsub.bf16.

define bfloat @min4(bfloat %a0, bfloat %a1, bfloat %a2, bfloat %a3, bfloat %acc) {
; CHECK-LABEL: min4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cv.fmin.bf16 a0, a0, a4
; CHECK-NEXT:    cv.fmin.bf16 a1, a2, a1
; CHECK-NEXT:    cv.fmin.bf16 a0, a1, a0
; CHECK-NEXT:    cv.fmin.bf16 a0, a3, a0
; CHECK-NEXT:    ret
  %t0 = call bfloat @llvm.minnum.bf16(bfloat %a0, bfloat %acc)
  %t1 = call bfloat @llvm.minnum.bf16(bfloat %a1, bfloat %t0)
  %t2 = call bfloat @llvm.minnum.bf16(bfloat %a2, bfloat %t1)
  %t3 = call bfloat @llvm.minnum.bf16(bfloat %a3, bfloat %t2)
  ret bfloat %t3
}

define bfloat @max4(bfloat %a0, bfloat %a1, bfloat %a2, bfloat %a3, bfloat %acc) {
; CHECK-LABEL: max4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cv.fmax.bf16 a0, a0, a4
; CHECK-NEXT:    cv.fmax.bf16 a1, a2, a1
; CHECK-NEXT:    cv.fmax.bf16 a0, a1, a0
; CHECK-NEXT:    cv.fmax.bf16 a0, a3, a0
; CHECK-NEXT:    ret
  %t0 = call bfloat @llvm.maxnum.bf16(bfloat %a0, bfloat %acc)
  %t1 = call bfloat @llvm.maxnum.bf16(bfloat %a1, bfloat %t0)
  %t2 = call bfloat @llvm.maxnum.bf16(bfloat %a2, bfloat %t1)
  %t3 = call bfloat @llvm.maxnum.bf16(bfloat %a3, bfloat %t2)
  ret bfloat %t3
}

define bfloat @sum4(bfloat %a0, bfloat %a1, bfloat %a2, bfloat %a3) {
; CHECK-LABEL: sum4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cv.fadd.bf16 a0, a0, a1
; CHECK-NEXT:    cv.fadd.bf16 a1, a2, a3
; CHECK-NEXT:    cv.fadd.bf16 a0, a0, a1
; CHECK-NEXT:    ret
  %t0 = fadd reassoc nsz bfloat %a0, %a1
  %t1 = fadd reassoc nsz bfloat %t0, %a2
  %t2 = fadd reassoc nsz bfloat %t1, %a3
  ret bfloat %t2
}

define bfloat @sub3(bfloat %a0, bfloat %a1, bfloat %a2, bfloat %a3) {
; CHECK-LABEL: sub3:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cv.fadd.bf16 a0, a0, a1
; CHECK-NEXT:    cv.fsub.bf16 a1, a2, a3
; CHECK-NEXT:    cv.fsub.bf16 a0, a0, a1
; CHECK-NEXT:    ret
  %t0 = fadd reassoc nsz bfloat %a0, %a1
  %t1 = fsub reassoc nsz bfloat %t0, %a2
  %t2 = fadd reassoc nsz bfloat %t1, %a3
  ret bfloat %t2
}

define bfloat @prod4(bfloat %a0, bfloat %a1, bfloat %a2, bfloat %a3) {
; CHECK-LABEL: prod4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cv.fmul.bf16 a0, a0, a1
; CHECK-NEXT:    cv.fmul.bf16 a1, a2, a3
; CHECK-NEXT:    cv.fmul.bf16 a0, a0, a1
; CHECK-NEXT:    ret
  %t0 = fmul reassoc nsz bfloat %a0, %a1
  %t1 = fmul reassoc nsz bfloat %t0, %a2
  %t2 = fmul reassoc nsz bfloat %t1, %a3
  ret bfloat %t2
}

; Without reassoc the chain is kept.
define bfloat @sum4_strict(bfloat %a0, bfloat %a1, bfloat %a2, bfloat %a3) {
; CHECK-LABEL: sum4_strict:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cv.fadd.bf16 a0, a0, a1
; CHECK-NEXT:    cv.fadd.bf16 a0, a0, a2
; CHECK-NEXT:    cv.fadd.bf16 a0, a0, a3
; CHECK-NEXT:    ret
  %t0 = fadd bfloat %a0, %a1
  %t1 = fadd bfloat %t0, %a2
  %t2 = fadd bfloat %t1, %a3
  ret bfloat %t2
}

; The fmul has two uses, so instruction selection keeps it; the
; MachineCombiner fuses it into the fadd and the fsub.
define void @fma_multiuse(bfloat %a, bfloat %b, bfloat %c, bfloat %d, ptr %p) {
; CHECK-LABEL: fma_multiuse:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cv.fmadd.bf16 a2, a0, a1, a2
; CHECK-NEXT:    cv.fmsub.bf16 a5, a0, a1, a3
; CHECK-NEXT:    cv.fnmsub.bf16 a0, a0, a1, a3
; CHECK-NEXT:    sh a2, 0(a4)
; CHECK-NEXT:    sh a5, 2(a4)
; CHECK-NEXT:    sh a0, 4(a4)
; CHECK-NEXT:    ret
  %m = fmul contract bfloat %a, %b
  %s = fadd contract bfloat %m, %c
  %t = fsub contract bfloat %m, %d
  %u = fsub contract bfloat %d, %m
  store bfloat %s, ptr %p
  %p1 = getelementptr bfloat, ptr %p, i32 1
  store bfloat %t, ptr %p1
  %p2 = getelementptr bfloat, ptr %p, i32 2
  store bfloat %u, ptr %p2
  ret void
}
