}

declare i32 @llvm.bswap.i32(i32)

; Copy of 2-byte aligned halves: no v2i16 merge, which would be a misaligned
; i32 access split back into the halves (infinite store merging loop).
define void @copy_align2(ptr %d, ptr %s) {
; CHECK-LABEL: copy_align2:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lh a2, 0(a1)
; CHECK-NEXT:    lh a1, 2(a1)
; CHECK-NEXT:    sh a2, 0(a0)
; CHECK-NEXT:    sh a1, 2(a0)
; CHECK-NEXT:    ret
entry:
  %v0 = load i16, ptr %s, align 2
  %s1 = getelementptr i8, ptr %s, i32 2
  %v1 = load i16, ptr %s1, align 2
  store i16 %v0, ptr %d, align 2
  %d1 = getelementptr i8, ptr %d, i32 2
  store i16 %v1, ptr %d1, align 2
  ret void
}

; The packed vectors are passed in the GPRs, also by fastcc (internal functions)
define internal fastcc <4 x i8> @fastcc_add(<4 x i8> %a, <4 x i8> %b) noinline {
; CHECK-LABEL: fastcc_add:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    cv.add.b a0, a0, a1
; CHECK-NEXT:    ret
entry:
  %r = add <4 x i8> %a, %b
  ret <4 x i8> %r
}

define i32 @call_fastcc(i32 %a, i32 %b) {
; CHECK-LABEL: call_fastcc:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sw ra, 12(sp) # 4-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -4
; CHECK-NEXT:    call fastcc_add
; CHECK-NEXT:    lw ra, 12(sp) # 4-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
entry:
  %va = bitcast i32 %a to <4 x i8>
  %vb = bitcast i32 %b to <4 x i8>
  %r = call fastcc <4 x i8> @fastcc_add(<4 x i8> %va, <4 x i8> %vb)
  %ri = bitcast <4 x i8> %r to i32
  ret i32 %ri
}
