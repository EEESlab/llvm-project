define void @copy(ptr nofree writeonly captures(none) %d, ptr nofree readonly captures(none) %s, i32 %n) {
; CHECK-LABEL: copy:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    blez a2, .LBB16_3
; CHECK-NEXT:  # %bb.1: # %for.body.preheader
; CHECK-NEXT:    lui a3, 4112
; CHECK-NEXT:    addi a3, a3, 257
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:    .option push
; CHECK-NEXT:    .option norvc
; CHECK-NEXT:    cv.setup 0, a2, .LBB16_3
; CHECK-NEXT:  # %bb.2: # %for.body
; CHECK-NEXT:    cv.lw a4, (a1), 4
; CHECK-NEXT:    cv.sll.b a4, a4, a3
; CHECK-NEXT:    cv.sw a4, (a0), 4
; CHECK-NEXT:  .LBB16_3: # %for.cond.cleanup
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .option pop
; CHECK-NEXT:    ret
entry:
  %cmp8 = icmp sgt i32 %n, 0
  br i1 %cmp8, label %for.body, label %for.cond.cleanup

for.cond.cleanup:                                 ; preds = %for.body, %entry
  ret void

for.body:                                         ; preds = %entry, %for.body
  %i.09 = phi i32 [ %inc, %for.body ], [ 0, %entry ]
  %arrayidx = getelementptr inbounds nuw [4 x i8], ptr %s, i32 %i.09
  %0 = load <4 x i8>, ptr %arrayidx, align 4
  %add = shl <4 x i8> %0, splat (i8 1)
  %arrayidx2 = getelementptr inbounds nuw [4 x i8], ptr %d, i32 %i.09
  store <4 x i8> %add, ptr %arrayidx2, align 4
  %inc = add nuw nsw i32 %i.09, 1
  %exitcond.not = icmp eq i32 %inc, %n
  br i1 %exitcond.not, label %for.cond.cleanup, label %for.body
}

define i32 @sel(i32 %c, i32 %a.coerce, i32 %b.coerce) {
; CHECK-LABEL: sel:
