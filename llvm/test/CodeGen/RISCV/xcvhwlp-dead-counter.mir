# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv32 -mattr=+m,+xcvmem,+xcvhwlp -run-pass=riscv-hardware-loops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# The software countdown that LSR leaves next to a hardware loop must be
# removed once the loop is converted. The pass finds it from the loop-end
# pseudo, which reads it through the copy before it.

# The count register $x12 first held a pointer argument, which was saved to
# $x9 before $x12 was reused for the count; $x9 is used after the loop. The
# saved copy is not the counter: the countdown runs on $x12 itself.
---
name:            saved_arg_reg
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: saved_arg_reg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x9 = ADDI killed $x12, 0
  ; CHECK-NEXT:   renamable $x12 = ADDI $x0, 8
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCBegin
  ; CHECK-NEXT:   CV_SETUP 0, $x12, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x9, $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
  ; CHECK-NEXT:   renamable $x6, renamable $x11 = CV_LW_ri_inc killed renamable $x11, 4
  ; CHECK-NEXT:   renamable $x5 = ADD killed renamable $x5, killed renamable $x6
  ; CHECK-NEXT:   renamable $x9 = CV_SW_ri_inc killed renamable $x5, killed renamable $x9, 4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCEnd
  ; CHECK-NEXT:   $x10 = ADDI killed $x9, 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11, $x12
    $x9 = ADDI killed $x12, 0
    renamable $x12 = ADDI $x0, 8
    PseudoCVHWLoopSetup renamable $x12

  bb.1:
    liveins: $x9, $x10, $x11, $x12
    renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
    renamable $x6, renamable $x11 = CV_LW_ri_inc killed renamable $x11, 4
    renamable $x5 = ADD killed renamable $x5, killed renamable $x6
    renamable $x9 = CV_SW_ri_inc killed renamable $x5, killed renamable $x9, 4
    $x16 = ADDI renamable $x12, 0
    renamable $x16 = PseudoCVHWLoopEnd killed renamable $x16
    renamable $x12 = ADDI killed renamable $x12, -1
    BNE killed renamable $x16, $x0, %bb.1

  bb.2:
    liveins: $x9
    $x10 = ADDI killed $x9, 0
    PseudoRET implicit $x10
...

# The trip count is in two registers with the same value: $x12 is read by
# cv.setup and used after the loop, $x13 starts the countdown in $x14.
---
name:            count_in_two_regs
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: count_in_two_regs
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCBegin
  ; CHECK-NEXT:   CV_SETUP 0, $x12, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
  ; CHECK-NEXT:   renamable $x6 = LW renamable $x11, 0
  ; CHECK-NEXT:   renamable $x5 = ADD killed renamable $x5, killed renamable $x6
  ; CHECK-NEXT:   renamable $x11 = CV_SW_ri_inc killed renamable $x5, killed renamable $x11, 4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCEnd
  ; CHECK-NEXT:   $x10 = ADDI killed $x12, 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11, $x12, $x13
    PseudoCVHWLoopSetup renamable $x12
    $x14 = ADDI killed $x13, 0

  bb.1:
    liveins: $x10, $x11, $x12, $x14
    renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
    renamable $x6 = LW renamable $x11, 0
    renamable $x5 = ADD killed renamable $x5, killed renamable $x6
    renamable $x11 = CV_SW_ri_inc killed renamable $x5, killed renamable $x11, 4
    $x7 = ADDI renamable $x14, 0
    renamable $x7 = PseudoCVHWLoopEnd killed renamable $x7
    renamable $x14 = ADDI killed renamable $x14, -1
    BNE killed renamable $x7, $x0, %bb.1

  bb.2:
    liveins: $x12
    $x10 = ADDI killed $x12, 0
    PseudoRET implicit $x10
...

# The countdown shares its register with the trip count: the setup pseudo
# consumes the count in $x12, and the move after it reloads $x12 with the
# countdown's start value from $x13. That move belongs to the dead counter and
# is removed with it, so the trip count is still in $x12 at the setup point.
---
name:            count_reg_reloaded
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: count_reg_reloaded
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCBegin
  ; CHECK-NEXT:   CV_SETUP 0, $x12, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x5 = LW renamable $x10, 0
  ; CHECK-NEXT:   renamable $x5 = ADD killed renamable $x5, renamable $x11
  ; CHECK-NEXT:   renamable $x10 = CV_SW_ri_inc killed renamable $x5, killed renamable $x10, 4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCEnd
  ; CHECK-NEXT:   $x10 = ADDI killed $x13, 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11, $x12, $x13
    PseudoCVHWLoopSetup killed renamable $x12
    $x12 = ADDI renamable $x13, 0

  bb.1:
    liveins: $x10, $x11, $x12, $x13
    renamable $x5 = LW renamable $x10, 0
    renamable $x5 = ADD killed renamable $x5, renamable $x11
    renamable $x10 = CV_SW_ri_inc killed renamable $x5, killed renamable $x10, 4
    $x14 = ADDI renamable $x12, 0
    renamable $x14 = PseudoCVHWLoopEnd killed renamable $x14
    renamable $x12 = ADDI killed renamable $x12, -1
    BNE killed renamable $x14, $x0, %bb.1

  bb.2:
    liveins: $x13
    $x10 = ADDI killed $x13, 0
    PseudoRET implicit $x10
...

# Same shape, but the reloaded register is used after the loop: the move must
# stay, it clobbers the trip count, and the loop is not converted.
---
name:            count_reg_reloaded_live_out
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: count_reg_reloaded_live_out
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopSetup killed renamable $x12
  ; CHECK-NEXT:   $x12 = ADDI renamable $x13, 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x5 = LW renamable $x10, 0
  ; CHECK-NEXT:   renamable $x5 = ADD killed renamable $x5, renamable $x11
  ; CHECK-NEXT:   renamable $x10 = CV_SW_ri_inc killed renamable $x5, killed renamable $x10, 4
  ; CHECK-NEXT:   $x12 = PseudoCVHWLoopEnd $x12
  ; CHECK-NEXT:   BNE $x12, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = ADDI killed $x12, 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11, $x12, $x13
    PseudoCVHWLoopSetup killed renamable $x12
    $x12 = ADDI renamable $x13, 0

  bb.1:
    liveins: $x10, $x11, $x12, $x13
    renamable $x5 = LW renamable $x10, 0
    renamable $x5 = ADD killed renamable $x5, renamable $x11
    renamable $x10 = CV_SW_ri_inc killed renamable $x5, killed renamable $x10, 4
    $x14 = ADDI renamable $x12, 0
    renamable $x14 = PseudoCVHWLoopEnd killed renamable $x14
    renamable $x12 = ADDI killed renamable $x12, -1
    BNE killed renamable $x14, $x0, %bb.1

  bb.2:
    liveins: $x12
    $x10 = ADDI killed $x12, 0
    PseudoRET implicit $x10
...

# A constant trip count: cv.setupi takes the count as an immediate, and the
# countdown starts from a load immediate after the setup pseudo. Both the load
# immediate and the decrement are removed.
---
name:            imm_count
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: imm_count
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCBegin
  ; CHECK-NEXT:   CV_SETUPI 0, 100, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x13 = LW renamable $x11, 0
  ; CHECK-NEXT:   renamable $x13 = ADDI killed renamable $x13, 1
  ; CHECK-NEXT:   SW killed renamable $x13, renamable $x10, 0
  ; CHECK-NEXT:   renamable $x10 = ADDI killed renamable $x10, 4
  ; CHECK-NEXT:   renamable $x11 = ADDI killed renamable $x11, 4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCEnd
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    liveins: $x10, $x11
    PseudoCVHWLoopSetupImm 100
    renamable $x12 = ADDI $x0, 100

  bb.1:
    liveins: $x10, $x11, $x12
    renamable $x13 = LW renamable $x11, 0
    renamable $x13 = ADDI killed renamable $x13, 1
    $x14 = ADDI renamable $x12, 0
    SW killed renamable $x13, renamable $x10, 0
    renamable $x14 = PseudoCVHWLoopEnd killed renamable $x14
    renamable $x10 = ADDI killed renamable $x10, 4
    renamable $x11 = ADDI killed renamable $x11, 4
    renamable $x12 = nsw ADDI killed renamable $x12, -1
    BNE killed renamable $x14, $x0, %bb.1

  bb.2:
    PseudoRET
...

# Same, but the countdown is used after the loop: nothing is removed.
