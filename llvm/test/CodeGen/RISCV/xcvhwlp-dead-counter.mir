  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x13 = LW renamable $x11, 0
  ; CHECK-NEXT:   renamable $x13 = ADDI killed renamable $x13, 1
  ; CHECK-NEXT:   $x14 = ADDI renamable $x12, 0
  ; CHECK-NEXT:   SW killed renamable $x13, renamable $x10, 0
  ; CHECK-NEXT:   renamable $x10 = ADDI killed renamable $x10, 4
  ; CHECK-NEXT:   renamable $x11 = ADDI killed renamable $x11, 4
  ; CHECK-NEXT:   renamable $x12 = nsw ADDI killed renamable $x12, -1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCEnd
  ; CHECK-NEXT:   $x10 = ADDI killed $x12, 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11
    PseudoCVHWLoopSetupImm 100
