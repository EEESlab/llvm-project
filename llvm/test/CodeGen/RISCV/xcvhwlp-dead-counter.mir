# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv32 -mattr=+m,+xcvmem,+xcvhwlp -run-pass=riscv-hardware-loops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# The software countdown that LSR leaves next to a hardware loop must be
# removed once the loop is converted. The pass finds it from the loop-end
# pseudo, which reads it through the copy before it.

# The count register $x12 first held a pointer argument, which was saved to
# $x9 before $x12 was reused for the count; $x9 is used after the loop. The
# saved copy is not the counter: the countdown runs on $x12 itself.
---
name:            saved_arg_reg
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: saved_arg_reg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x9 = ADDI killed $x12, 0
  ; CHECK-NEXT:   renamable $x12 = ADDI $x0, 8
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCBegin
  ; CHECK-NEXT:   CV_SETUP 0, $x12, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x9, $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
  ; CHECK-NEXT:   renamable $x6, renamable $x11 = CV_LW_ri_inc killed renamable $x11, 4
  ; CHECK-NEXT:   renamable $x5 = ADD killed renamable $x5, killed renamable $x6
  ; CHECK-NEXT:   renamable $x9 = CV_SW_ri_inc killed renamable $x5, killed renamable $x9, 4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCEnd
  ; CHECK-NEXT:   $x10 = ADDI killed $x9, 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11, $x12
    $x9 = ADDI killed $x12, 0
    renamable $x12 = ADDI $x0, 8
    PseudoCVHWLoopSetup renamable $x12

  bb.1:
    liveins: $x9, $x10, $x11, $x12
    renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
    renamable $x6, renamable $x11 = CV_LW_ri_inc killed renamable $x11, 4
    renamable $x5 = ADD killed renamable $x5, killed renamable $x6
    renamable $x9 = CV_SW_ri_inc killed renamable $x5, killed renamable $x9, 4
    $x16 = ADDI renamable $x12, 0
    renamable $x16 = PseudoCVHWLoopEnd killed renamable $x16
    renamable $x12 = ADDI killed renamable $x12, -1
    BNE killed renamable $x16, $x0, %bb.1

  bb.2:
    liveins: $x9
    $x10 = ADDI killed $x9, 0
    PseudoRET implicit $x10
...

# The trip count is in two registers with the same value: $x12 is read by
# cv.setup and used after the loop, $x13 starts the countdown in $x14.
---
name:            count_in_two_regs
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: count_in_two_regs
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCBegin
  ; CHECK-NEXT:   CV_SETUP 0, $x12, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
  ; CHECK-NEXT:   renamable $x6 = LW renamable $x11, 0
  ; CHECK-NEXT:   renamable $x5 = ADD killed renamable $x5, killed renamable $x6
  ; CHECK-NEXT:   renamable $x11 = CV_SW_ri_inc killed renamable $x5, killed renamable $x11, 4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCVHWLoopNoRVCEnd
  ; CHECK-NEXT:   $x10 = ADDI killed $x12, 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11, $x12, $x13
    PseudoCVHWLoopSetup renamable $x12
    $x14 = ADDI killed $x13, 0

  bb.1:
    liveins: $x10, $x11, $x12, $x14
    renamable $x5, renamable $x10 = CV_LW_ri_inc killed renamable $x10, 4
    renamable $x6 = LW renamable $x11, 0
    renamable $x5 = ADD killed renamable $x5, killed renamable $x6
    renamable $x11 = CV_SW_ri_inc killed renamable $x5, killed renamable $x11, 4
    $x7 = ADDI renamable $x14, 0
    renamable $x7 = PseudoCVHWLoopEnd killed renamable $x7
    renamable $x14 = ADDI killed renamable $x14, -1
    BNE killed renamable $x7, $x0, %bb.1

  bb.2:
    liveins: $x12
    $x10 = ADDI killed $x12, 0
    PseudoRET implicit $x10
...
