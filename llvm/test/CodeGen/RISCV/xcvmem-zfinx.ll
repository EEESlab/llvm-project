; ZFINX-NEXT:    # =>This Inner Loop Header: Depth=1
; ZFINX-NEXT:    cv.lw a4, (a0), 4
; ZFINX-NEXT:    cv.lw a5, (a1), 4
; ZFINX-NEXT:    fadd.s a4, a4, a5
; ZFINX-NEXT:    cv.sw a4, (a2), 4
; ZFINX-NEXT:    bne a2, a3, .LBB6_2
; ZFINX-NEXT:  .LBB6_3: # %exit
; ZFINX-NEXT:    ret
;
; F-LABEL: vadd:
; F:       # %bb.0: # %entry
; F-NEXT:    blez a3, .LBB6_3
; F-NEXT:  # %bb.1: # %loop.preheader
; F-NEXT:    slli a3, a3, 2
; F-NEXT:    add a3, a2, a3
; F-NEXT:  .LBB6_2: # %loop
; F-NEXT:    # =>This Inner Loop Header: Depth=1
; F-NEXT:    flw fa5, 0(a0)
; F-NEXT:    flw fa4, 0(a1)
; F-NEXT:    fadd.s fa5, fa5, fa4
; F-NEXT:    fsw fa5, 0(a2)
; F-NEXT:    addi a2, a2, 4
; F-NEXT:    addi a1, a1, 4
; F-NEXT:    addi a0, a0, 4
; F-NEXT:    bne a2, a3, .LBB6_2
; F-NEXT:  .LBB6_3: # %exit
; F-NEXT:    ret
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %inc, %loop ]
  %pa = getelementptr inbounds float, ptr %a, i32 %i
  %va = load float, ptr %pa
  %pb = getelementptr inbounds float, ptr %b, i32 %i
  %vb = load float, ptr %pb
