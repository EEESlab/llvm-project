; RUN: opt < %s -mtriple=riscv32 -mattr=+zhinx,+xcvhv,+xcvsimd -passes="print<cost-model>" \
; RUN:   -cost-kind=throughput -disable-output 2>&1 | FileCheck %s

; Costs of lane moves on the packed vectors that XCVhv and XCVsimd keep in
; GPRs: one instruction per lane for inserts/extracts and for building a
; vector from scalars, and per result GPR for shuffles (2 when the two lanes
; come from different GPRs, 0 when the GPR is already in place).

define void @f(<2 x half> %v, <2 x half> %w, <8 x half> %x, half %s, <4 x i8> %b, <4 x i8> %c, i8 %e) {
; CHECK-LABEL: 'f'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %ins0 = insertelement <2 x half> poison, half %s, i32 0
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %ins1 = insertelement <2 x half> %ins0, half %s, i32 1
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %swap = shufflevector <2 x half> %v, <2 x half> poison, <2 x i32> <i32 1, i32 0>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %il = shufflevector <2 x half> %v, <2 x half> %w, <4 x i32> <i32 0, i32 2, i32 1, i32 3>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 0 for instruction: %cat = shufflevector <2 x half> %v, <2 x half> %w, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %de = shufflevector <8 x half> %x, <8 x half> poison, <8 x i32> <i32 0, i32 4, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %bins = insertelement <4 x i8> %b, i8 %e, i32 2
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %bsh1 = shufflevector <4 x i8> %b, <4 x i8> poison, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %bsh2 = shufflevector <4 x i8> %b, <4 x i8> %c, <4 x i32> <i32 0, i32 4, i32 1, i32 5>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 0 for instruction: ret void
;
  %ins0 = insertelement <2 x half> poison, half %s, i32 0
  %ins1 = insertelement <2 x half> %ins0, half %s, i32 1
  %swap = shufflevector <2 x half> %v, <2 x half> poison, <2 x i32> <i32 1, i32 0>
  %il = shufflevector <2 x half> %v, <2 x half> %w, <4 x i32> <i32 0, i32 2, i32 1, i32 3>
  %cat = shufflevector <2 x half> %v, <2 x half> %w, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %de = shufflevector <8 x half> %x, <8 x half> poison, <8 x i32> <i32 0, i32 4, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison>
  %bins = insertelement <4 x i8> %b, i8 %e, i32 2
  %bsh1 = shufflevector <4 x i8> %b, <4 x i8> poison, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
  %bsh2 = shufflevector <4 x i8> %b, <4 x i8> %c, <4 x i32> <i32 0, i32 4, i32 1, i32 5>
  ret void
}
